{
  "id": "s08-01-failure-response-Q03-case",
  "revision": 2,
  "initial": {
    "sensor": "OLD",
    "service": "работает",
    "alert": "авария",
    "tested": false
  },
  "fields": [
    {
      "key": "sensor",
      "label": "Адрес датчика"
    },
    {
      "key": "service",
      "label": "Рабочая услуга"
    },
    {
      "key": "alert",
      "label": "Сигнал"
    },
    {
      "key": "tested",
      "label": "Рабочая функция проверена"
    }
  ],
  "computed": {},
  "lectureId": "s08-01-failure-response",
  "questionId": "s08-01-failure-response-Q03",
  "goal": "Исправить адрес датчика и подтвердить функцию без ненужного отказа рабочей услуги.",
  "rules": [
    "Датчик опрашивает выведенный узел OLD; рабочая услуга находится на LIVE. Независимый тест LIVE успешен."
  ],
  "actions": [
    {
      "id": "restart",
      "label": "Остановить рабочую услугу по сигналу OLD",
      "outcomes": [
        {
          "when": true,
          "set": {
            "service": "остановлена",
            "tested": false
          },
          "text": "Рабочая услуга остановлена; датчик продолжает опрашивать OLD."
        }
      ]
    },
    {
      "id": "start",
      "label": "Вернуть рабочую услугу",
      "outcomes": [
        {
          "when": true,
          "set": {
            "service": "работает",
            "tested": false
          },
          "text": "Рабочая услуга запущена."
        }
      ]
    },
    {
      "id": "address",
      "label": "Направить датчик на LIVE",
      "outcomes": [
        {
          "when": true,
          "set": {
            "sensor": "LIVE"
          },
          "text": "Изменён объект наблюдения; сигнал ещё не обновлён."
        }
      ]
    },
    {
      "id": "poll",
      "label": "Опросить датчик",
      "outcomes": [
        {
          "when": true,
          "set": {
            "alert": {
              "op": "if",
              "args": [
                {
                  "op": "and",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "ref": "sensor"
                        },
                        "LIVE"
                      ]
                    },
                    {
                      "op": "eq",
                      "args": [
                        {
                          "ref": "service"
                        },
                        "работает"
                      ]
                    }
                  ]
                },
                "норма",
                "авария"
              ]
            }
          },
          "text": "Сигнал: {alert}."
        }
      ]
    },
    {
      "id": "test",
      "label": "Выполнить независимую пользовательскую операцию",
      "outcomes": [
        {
          "when": true,
          "set": {
            "tested": {
              "op": "eq",
              "args": [
                {
                  "ref": "service"
                },
                "работает"
              ]
            }
          },
          "text": "Пользовательский тест: {tested}."
        }
      ]
    },
    {
      "id": "mute",
      "label": "Заглушить сигнал без проверки адреса",
      "outcomes": [
        {
          "when": true,
          "set": {
            "alert": "заглушён"
          },
          "text": "Сигнал скрыт, адрес датчика остался {sensor}."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "service"
          },
          "остановлена"
        ]
      },
      "text": "Рабочая услуга остановлена из-за датчика другого объекта. Сначала верните функцию."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "sensor"
          },
          "OLD"
        ]
      },
      "text": "Датчик смотрит на выведенный узел. Заглушение не исправит объект наблюдения."
    },
    {
      "when": true,
      "text": "Датчик {sensor}; сигнал {alert}; функция {tested}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "sensor"
          },
          "LIVE"
        ]
      },
      "text": "Датчик проверяет актуальную услугу"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "alert"
          },
          "норма"
        ]
      },
      "text": "Сигнал обновлён"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "tested"
          },
          true
        ]
      },
      "text": "Функция проверена независимо"
    }
  ],
  "debrief": "Исправление мониторинга не запускает остановленную услугу. Два последствия требуют разных операций.",
  "title": "Подтверждение события",
  "condition": "Сработал один датчик; независимый пользовательский тест успешен."
}
