            "args": [
              {
                "ref": "user"
              },
              false
            ]
          }
        ]
      },
      "text": "Обращение закрыто без подтверждения заявителем."
    },
    {
      "when": true,
      "text": "Стабильность {stable} мин.; операция заявителя {user}; закрыто {closed}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "symptom"
          },
          false
        ]
      },
      "text": "Симптом не активен"
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "user"
              },
              true
            ]
          },
          {
            "op": "gte",
            "args": [
              {
                "ref": "stable"
              },
              15
            ]
          }
        ]
      },
      "text": "Операция и полное непрерывное окно подтверждены"
    },
    {
