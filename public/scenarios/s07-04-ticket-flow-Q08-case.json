      "label": "Операция заявителя успешна"
    },
    {
      "key": "symptom",
      "label": "Симптом активен"
    },
    {
      "key": "closed",
      "label": "Обращение закрыто"
    }
  ],
  "computed": {},
  "lectureId": "s07-04-ticket-flow",
  "questionId": "s07-04-ticket-flow-Q08",
  "goal": "Подтвердить устойчивость функции у заявителя в полном контрольном окне.",
  "rules": [
    "Требуется успешная операция заявителя и 15 минут непрерывной стабильности. Повтор симптома обнуляет непрерывное окно."
  ],
  "actions": [
    {
      "id": "test",
      "label": "Выполнить операцию заявителя",
      "outcomes": [
        {
          "when": true,
          "set": {
            "user": {
              "op": "not",
              "args": [
                {
                  "ref": "symptom"
                }
              ]
            }
          },
          "text": "Операция заявителя успешна: {user}."
        }
      ]
    },
    {
      "id": "wait",
      "label": "Наблюдать 15 минут стабильности",
      "outcomes": [
        {
          "when": true,
          "set": {
            "stable": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "symptom"
                    },
                    false
                  ]
                },
                15,
                0
              ]
            }
          },
          "text": "Непрерывная стабильность {stable} минут."
        }
      ]
    },
    {
      "id": "close",
      "label": "Закрыть обращение",
      "outcomes": [
        {
          "when": true,
          "set": {
            "closed": true
          },
          "text": "Обращение закрыто при стабильности {stable} и проверке {user}."
        }
      ]
    },
    {
      "id": "recur",
      "label": "Воспроизвести возврат симптома в окне",
      "outcomes": [
        {
          "when": true,
          "set": {
            "symptom": true,
            "stable": 0,
            "user": false
          },
          "text": "Симптом вернулся; непрерывное окно прервано."
        }
      ]
    },
    {
      "id": "repair",
      "label": "Устранить обнаруженную причину повтора",
      "outcomes": [
        {
          "when": true,
          "set": {
            "symptom": false,
            "stable": 0,
            "user": false,
            "closed": false
          },
          "text": "Симптом устранён; требуется новое окно и операция."
        }
      ]
    },
    {
      "id": "accept",
      "label": "Закрыть по полному критерию",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "user"
                  },
                  true
                ]
              },
              {
                "op": "gte",
                "args": [
                  {
                    "ref": "stable"
                  },
                  15
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "symptom"
                  },
                  false
                ]
              }
            ]
          },
          "set": {
            "closed": true
          },
          "text": "Полный критерий приёмки подтверждён."
        },
        {
          "when": true,
          "set": {
            "closed": false
          },
          "text": "Непрерывное окно или проверка заявителя не выполнены."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
