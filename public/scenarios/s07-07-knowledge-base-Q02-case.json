    "article": "7.1",
    "queue": "исходное",
    "service": "отказ",
    "defect": "открыт"
  },
  "fields": [
    {
      "key": "version",
      "label": "Версия пользователя"
    },
    {
      "key": "article",
      "label": "Вариант инструкции"
    },
    {
      "key": "queue",
      "label": "Состояние очереди"
    },
    {
      "key": "service",
      "label": "Функция"
    },
    {
      "key": "defect",
      "label": "Дефект"
    }
  ],
  "computed": {},
  "lectureId": "s07-07-knowledge-base",
  "questionId": "s07-07-knowledge-base-Q02",
  "goal": "Применить обход только в совместимой версии и сохранить работу по дефекту.",
  "rules": [
    "Переключение очереди работает в версии 7.1; формат версии 8.0 несовместим.",
    "Для 8.0 в учебной модели есть проверенная адаптация обхода; дефект продукта остаётся отдельной работой."
  ],
  "actions": [
    {
      "id": "apply",
      "label": "Выполнить текущую инструкцию",
      "outcomes": [
        {
          "when": true,
          "set": {
            "queue": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "article"
                    },
                    {
                      "ref": "version"
                    }
                  ]
                },
                "временная очередь",
                "неверный формат"
              ]
            },
            "service": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "article"
                    },
                    {
                      "ref": "version"
                    }
                  ]
                },
                "работает через обход",
                "отказ"
              ]
            }
          },
          "text": "Очередь: {queue}; функция: {service}."
        }
      ]
    },
    {
      "id": "adapt",
      "label": "Выбрать проверенную инструкцию для 8.0",
      "outcomes": [
        {
          "when": true,
          "set": {
            "article": "8.0"
          },
          "text": "Выбрана инструкция другой области; текущая очередь ещё не изменена."
        }
      ]
    },
    {
      "id": "restore",
      "label": "Вернуть исходную конфигурацию очереди",
      "outcomes": [
        {
          "when": true,
          "set": {
            "queue": "исходное",
            "service": "отказ"
          },
          "text": "Последствия несовместимого переключения отменены."
        }
      ]
    },
    {
      "id": "close",
      "label": "Закрыть дефект по успеху обхода",
      "outcomes": [
        {
          "when": true,
          "set": {
            "defect": "закрыт"
          },
          "text": "Дефект закрыт, хотя обход не меняет продукт."
        }
      ]
    },
    {
      "id": "reopen",
      "label": "Сохранить отдельную работу по дефекту",
      "outcomes": [
        {
          "when": true,
          "set": {
            "defect": "открыт"
          },
          "text": "Постоянное исправление снова в работе."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "queue"
          },
          "неверный формат"
        ]
      },
      "text": "Инструкция 7.1 испортила конфигурацию 8.0. Выбор другой статьи не возвращает конфигурацию."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "defect"
          },
          "закрыт"
        ]
      },
      "text": "Временный обход принят за устранение дефекта. Верните постоянное исправление в работу."
    },
    {
      "when": true,
      "text": "Версия {version}; инструкция {article}; функция {service}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "service"
          },
          "работает через обход"
        ]
      },
      "text": "Обход восстановил функцию"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "queue"
          },
          "временная очередь"
        ]
      },
      "text": "Применён совместимый формат"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "defect"
          },
          "открыт"
        ]
      },
      "text": "Дефект сохраняется в отдельной работе"
    }
  ],
  "debrief": "Тип знания ограничивает обещаемый результат. Обход не является исправлением продукта.",
  "title": "Тип статьи",
  "condition": "Временное переключение очереди устраняет симптом, дефект сохраняется."
}
