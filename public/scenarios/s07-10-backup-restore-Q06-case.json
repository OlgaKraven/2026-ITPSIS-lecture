  "computed": {},
  "lectureId": "s07-10-backup-restore",
  "questionId": "s07-10-backup-restore-Q06",
  "goal": "Обеспечить восстановление с независимым ключом либо корректно обработать отсутствие единственного ключа.",
  "rules": [
    "В исходном аварийном случае ключ остался на потерянном сервере; из зашифрованной копии его получить нельзя.",
    "Для будущего цикла уполномоченный владелец может создать новый независимый ключ и контрольную копию."
  ],
  "actions": [
    {
      "id": "try",
      "label": "Попытаться расшифровать старую копию",
      "outcomes": [
        {
          "when": true,
          "set": {
            "oldData": "отказ расшифрования"
          },
          "text": "Ключ отсутствует; старые данные не извлечены."
        }
      ]
    },
    {
      "id": "guess",
      "label": "Подставить случайный ключ",
      "outcomes": [
        {
          "when": true,
          "set": {
            "oldData": "ошибка аутентификации шифротекста"
          },
          "text": "Случайный ключ не расшифровал старые данные."
        }
      ]
    },
    {
      "id": "record",
      "label": "Зафиксировать потерю единственного ключа",
      "outcomes": [
        {
          "when": true,
          "set": {
            "incident": true
          },
          "text": "Утрата зависимости старой копии зафиксирована."
        }
      ]
    },
    {
      "id": "key",
      "label": "Создать и независимо сохранить новый ключ",
      "outcomes": [
        {
          "when": true,
          "set": {
            "newKey": true,
            "tested": false
          },
          "text": "Новый ключ доступен уполномоченному владельцу вне исходного узла."
        }
      ]
    },
    {
      "id": "copy",
      "label": "Создать контрольную копию с новым ключом",
      "requires": {
        "op": "eq",
        "args": [
          {
            "ref": "newKey"
          },
          true
        ]
      },
      "blocked": "Нужен новый доступный ключ.",
      "outcomes": [
        {
          "when": true,
          "set": {
            "newCopy": true,
            "tested": false
          },
          "text": "Контрольные данные зашифрованы новым ключом."
        }
      ]
    },
    {
      "id": "test",
      "label": "Восстановить контрольную копию на отдельном стенде",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "newKey"
                  },
                  true
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "newCopy"
                  },
                  true
                ]
              }
            ]
          },
          "set": {
            "tested": true
          },
          "text": "Новый цикл восстановлен без исходного сервера. Старые данные всё ещё недоступны."
        },
        {
          "when": true,
          "set": {
            "tested": false
          },
          "text": "Для нового опыта не хватает ключа или копии."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "ne",
        "args": [
          {
            "ref": "oldData"
          },
          "не восстановлены"
        ]
      },
      "text": "Старая копия: {oldData}. Подмена ключа не возвращает утраченную зависимость."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "tested"
          },
          true
        ]
      },
      "text": "Новый цикл проверен; потеря старых данных должна остаться в учёте."
    },
    {
      "when": true,
      "text": "Старый ключ недоступен. Учтите потерю и проверьте независимое хранение ключа для будущего цикла."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "incident"
          },
          true
        ]
      },
      "text": "Утрата старого ключа явно учтена"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "tested"
          },
          true
        ]
      },
      "text": "Новый независимый цикл проверен"
    }
  ],
  "debrief": "Новый ключ не может расшифровать старую копию. Исправляется будущий процесс; прошлое ограничение сохраняется.",
  "title": "Защита и ответственность",
  "condition": "Копия зашифрована, ключ доступен только на потерянном сервере."
}
