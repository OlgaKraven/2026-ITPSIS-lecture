  },
  "fields": [
    {
      "key": "oldKey",
      "label": "Ключ старой копии доступен"
    },
    {
      "key": "oldData",
      "label": "Старые данные"
    },
    {
      "key": "newKey",
      "label": "Новый ключ сохранён независимо"
    },
    {
      "key": "newCopy",
      "label": "Новая контрольная копия"
    },
    {
      "key": "tested",
      "label": "Проверка нового цикла"
