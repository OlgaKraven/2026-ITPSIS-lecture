      "label": "Объявить причиной снижение нагрузки",
      "outcomes": [
        {
          "when": true,
          "set": {
            "decision": "выдуманная причина",
            "sent": true
          },
          "text": "Причина объявлена без исследования; поток во втором периоде фактически вырос."
        }
      ]
    }
