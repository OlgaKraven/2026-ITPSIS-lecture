      "label": "Одновременно обновить браузер",
      "outcomes": [
        {
          "when": true,
          "set": {
            "version": 121,
            "confirmed": false
          },
          "text": "Сборка изменена; сравнение со сборкой 120 больше не изолирует расширение."
        }
      ]
    },
    {
      "id": "restore",
      "label": "Вернуть сборку 120 и очистить несопоставимые пробы",
      "outcomes": [
        {
          "when": true,
          "set": {
            "version": 120,
            "off": "нет",
            "on": "нет",
