          },
          "text": "Опыт на 121 не относится к фиксированной исходной сборке."
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "extension"
              },
              true
            ]
          },
          "set": {
            "on": "сбой",
            "result": "сбой"
          },
          "text": "На 120 с расширением отправка падает."
        },
        {
          "when": true,
          "set": {
            "off": "успех",
            "result": "успех"
          },
          "text": "На 120 без расширения отправка успешна."
        }
      ]
    },
    {
      "id": "compare",
      "label": "Проверить две пробы",
      "outcomes": [
        {
          "when": true,
          "set": {
            "confirmed": {
