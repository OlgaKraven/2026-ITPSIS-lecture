                  ]
                },
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "off"
                    },
                    "успех"
                  ]
                },
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "on"
                    },
                    "сбой"
                  ]
                }
              ]
            }
          },
          "text": "Обратимая связь подтверждена: {confirmed}."
