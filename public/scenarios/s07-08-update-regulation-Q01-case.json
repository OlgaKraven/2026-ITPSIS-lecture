{
  "id": "s07-08-update-regulation-Q01-case",
  "revision": 2,
  "initial": {
    "api": 4,
    "client": 4,
    "manifest": false,
    "bridge": false,
    "tested": false,
    "service": "работают"
  },
  "fields": [
    {
      "key": "api",
      "label": "Версия API"
    },
    {
      "key": "client",
      "label": "Версия клиента"
    },
    {
      "key": "manifest",
      "label": "Состав релиза зафиксирован"
    },
    {
      "key": "bridge",
      "label": "Проверка клиента 4 с API 5"
    },
    {
      "key": "tested",
      "label": "Справка проверена на текущих версиях"
    },
    {
      "key": "service",
      "label": "Запросы клиента"
    }
  ],
  "computed": {
    "service": {
      "op": "if",
      "args": [
        {
          "op": "and",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "ref": "client"
                },
                5
              ]
            },
            {
              "op": "eq",
              "args": [
                {
                  "ref": "api"
                },
                4
              ]
            }
          ]
        },
        "отказ: несовместимый API",
        "работают"
      ]
    }
  },
  "lectureId": "s07-08-update-regulation",
  "questionId": "s07-08-update-regulation-Q01",
  "goal": "Перевести клиент и API с версии 4 на 5, сохранив совместимость и подтвердив выдачу справки.",
  "rules": [
    "Клиент 4 работает с API 4 и 5; клиент 5 работает только с API 5.",
    "До перехода клиента требуется проба клиента 4 с API 5. После изменения версии прежняя проверка теряет силу."
  ],
  "actions": [
    {
      "id": "manifest",
      "label": "Зафиксировать версии клиента и API",
      "outcomes": [
        {
          "when": true,
          "set": {
            "manifest": true
          },
          "text": "В плане зафиксированы клиент 5 и API 5."
        }
      ]
    },
    {
      "id": "api5",
      "label": "Установить API 5",
      "outcomes": [
        {
          "when": true,
          "set": {
            "api": 5,
            "tested": false,
            "bridge": false
          },
          "text": "API обновлён. Клиент {client}: {service}."
        }
      ]
    },
    {
      "id": "client5",
      "label": "Установить клиент 5",
      "outcomes": [
        {
          "when": true,
          "set": {
            "client": 5,
            "tested": false
          },
          "text": "Клиент обновлён. Ответ системы: {service}."
        }
      ]
    },
    {
      "id": "bridge",
      "label": "Выполнить пробу старого клиента",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "api"
                  },
                  5
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "client"
                  },
                  4
                ]
              }
            ]
          },
          "set": {
            "bridge": true
          },
          "text": "Клиент 4 успешно получил справку через API 5."
        },
        {
          "when": true,
          "set": {
            "bridge": false
          },
          "text": "Проба переходного сочетания невозможна: сейчас клиент {client}, API {api}."
        }
      ]
    },
    {
      "id": "test",
      "label": "Запросить справку текущим клиентом",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "api"
                  },
                  5
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "client"
                  },
                  5
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "bridge"
                  },
                  true
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "manifest"
                  },
                  true
                ]
              }
            ]
          },
          "set": {
            "tested": true
          },
          "text": "Справка сформирована на согласованных версиях 5/5."
        },
        {
          "when": true,
          "set": {
            "tested": false
          },
          "text": "Ответ запроса: {service}. Условия приёмки релиза ещё не выполнены."
        }
      ]
    },
    {
      "id": "client4",
      "label": "Вернуть клиент 4",
      "visible": {
        "op": "eq",
        "args": [
          {
            "ref": "client"
          },
          5
        ]
      },
      "outcomes": [
        {
          "when": true,
          "set": {
            "client": 4,
            "tested": false
          },
          "text": "Клиент возвращён к 4. Запросы: {service}."
        }
      ]
    },
    {
      "id": "api4",
      "label": "Вернуть API 4",
      "visible": {
        "op": "eq",
        "args": [
          {
            "ref": "api"
          },
          5
        ]
      },
      "outcomes": [
        {
          "when": true,
          "set": {
            "api": 4,
            "bridge": false,
            "tested": false
          },
          "text": "API возвращён к 4. Ответ клиенту: {service}."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "service"
          },
          "отказ: несовместимый API"
        ]
      },
      "text": "Клиент {client} не может работать с API {api}. Требуется восстановить совместимое сочетание; повтор запроса не меняет версии."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "manifest"
          },
          false
        ]
      },
      "text": "План не задаёт точный состав. Можно выполнить установку, но её ещё нельзя принять как согласованный релиз."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "api"
          },
          4
        ]
      },
      "text": "Работает сочетание 4/4. Предстоит выбрать первую установку."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "bridge"
          },
          false
        ]
      },
      "text": "Текущее сочетание {client}/{api}. Проба старого клиента с новым API ещё не получена."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "tested"
          },
          false
        ]
      },
      "text": "Переходный тест есть. Выполните переход и запрос справки на итоговых версиях."
    },
    {
      "when": true,
      "text": "Справка на клиенте 5 и API 5 получена; промежуточная совместимость подтверждена."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "manifest"
          },
          true
        ]
      },
      "text": "Состав релиза зафиксирован"
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "api"
              },
              5
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "ref": "client"
              },
              5
            ]
          }
        ]
      },
      "text": "Установлены клиент 5 и API 5"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "bridge"
          },
          true
        ]
      },
      "text": "Проверено переходное сочетание"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "tested"
          },
          true
        ]
      },
      "text": "Получена справка на текущих версиях"
    }
  ],
  "debrief": "Ранняя установка клиента действительно меняет его версию и ломает запросы к API 4. API 5 восстанавливает совместимость, но не создаёт задним числом свидетельство переходного теста: для него нужно вернуть старый клиент и выполнить пробу.",
  "title": "Цель и состав релиза",
  "condition": "План «обновить систему» не перечисляет версии клиента и API."
}
