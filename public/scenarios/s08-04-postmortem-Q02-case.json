{
  "id": "s08-04-postmortem-Q02-case",
  "revision": 2,
  "initial": {
    "earliest": 58,
    "interval": 6,
    "reportStart": 58,
    "claim": "не указан",
    "searched": false
  },
  "fields": [
    {
      "key": "earliest",
      "label": "Самая ранняя найденная минута после 09:00"
    },
    {
      "key": "interval",
      "label": "До сигнала 10:04",
      "unit": "мин"
    },
    {
      "key": "reportStart",
      "label": "Граница в отчёте"
    },
    {
      "key": "claim",
      "label": "Тип границы"
    },
    {
      "key": "searched",
      "label": "Расширенный поиск выполнен"
    }
  ],
  "computed": {
    "interval": {
      "op": "sub",
      "args": [
        64,
        {
          "ref": "earliest"
        }
      ]
    }
  },
  "lectureId": "s08-04-postmortem",
  "questionId": "s08-04-postmortem-Q02",
  "goal": "Обновить найденную границу события и связанный интервал до сигнала без заявления о неизвестном фактическом начале.",
  "rules": [
    "Сигнал в 10:04. Первая найденная ошибка 09:58; при расширенном поиске находится 09:55.",
    "Это нижняя найденная граница свидетельств, а не доказанное начало всех нарушений."
  ],
  "actions": [
    {
      "id": "exact",
      "label": "Объявить 09:58 точным началом отказа",
      "outcomes": [
        {
          "when": true,
          "set": {
            "claim": "точное начало всех нарушений",
            "reportStart": 58
          },
          "text": "Ограниченное свидетельство выдано за точную границу."
        }
      ]
    },
    {
      "id": "search",
      "label": "Расширить поиск до 09:55",
      "outcomes": [
        {
          "when": true,
          "set": {
            "earliest": 55,
            "searched": true
          },
          "text": "Найдена более ранняя ошибка. Интервал до сигнала теперь {interval} мин.; старый отчёт не обновлён."
        }
      ]
    },
    {
      "id": "ignore",
      "label": "Оставить прежнюю границу в отчёте",
      "outcomes": [
        {
          "when": true,
          "set": {
            "reportStart": 58
          },
          "text": "Отчёт продолжает исключать ранние три минуты."
        }
      ]
    },
    {
      "id": "update",
      "label": "Обновить отчёт с ограничением свидетельствами",
      "outcomes": [
        {
          "when": true,
          "set": {
            "reportStart": {
              "ref": "earliest"
            },
            "claim": "самая ранняя найденная ошибка"
          },
          "text": "Отчётная граница обновлена до найденной; фактическое начало может быть раньше."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "ne",
        "args": [
          {
            "ref": "reportStart"
          },
          {
            "ref": "earliest"
          }
        ]
      },
      "text": "Найдена ошибка на минуте {earliest}, отчёт всё ещё начинается с {reportStart}. Меняются интервал обнаружения и охват анализа."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "claim"
          },
          "точное начало всех нарушений"
        ]
      },
      "text": "Точная граница заявлена без достаточного покрытия источников. Расширьте поиск и ограничьте вывод."
    },
    {
      "when": true,
      "text": "Найденная граница {earliest}; интервал {interval} мин.; тип записи {claim}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "searched"
          },
          true
        ]
      },
      "text": "Выполнен расширенный поиск"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "reportStart"
          },
          55
        ]
      },
      "text": "Учтено раннее свидетельство"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "claim"
          },
          "самая ранняя найденная ошибка"
        ]
      },
      "text": "Неизвестное начало не выдано за точное"
    }
  ],
  "debrief": "Новое свидетельство пересчитывает интервал, но отчёт надо обновить отдельно.",
  "title": "Границы события",
  "condition": "Сигнал появился в 10:04, первые нарушенные операции найдены в 09:58."
}
