  },
  "fields": [
    {
      "key": "queue",
      "label": "Маршрут заявки"
    },
    {
      "key": "approved",
      "label": "Роль согласована"
    },
    {
      "key": "account",
      "label": "Учётная запись создана"
    },
    {
      "key": "role",
      "label": "Фактическая роль"
    },
    {
      "key": "access",
      "label": "Проверка чтения"
    },
    {
      "key": "excess",
      "label": "Избыточные права"
    }
  ],
  "computed": {},
  "lectureId": "s07-02-support-levels",
  "questionId": "s07-02-support-levels-Q05",
  "goal": "Предоставить новую согласованную роль без избыточных прав и проверить нужную функцию.",
  "rules": [
    "У пользователя нет утраченной функции; требуется новое предоставление.",
    "Согласована роль «читатель». Учётная запись без роли не даёт функцию; администратор — избыточное право."
  ],
  "actions": [
    {
      "id": "incident",
      "label": "Направить в очередь восстановления инцидентов",
      "outcomes": [
        {
          "when": true,
          "set": {
            "queue": "инциденты"
          },
          "text": "Группа восстановления ищет утраченную функцию, которой не было."
        }
      ]
    },
    {
      "id": "request",
      "label": "Направить запрос предоставления",
      "outcomes": [
        {
          "when": true,
          "set": {
            "queue": "предоставление"
          },
          "text": "Заявка направлена владельцу новой роли."
        }
      ]
    },
    {
      "id": "approve",
      "label": "Получить согласование читателя",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "queue"
              },
              "предоставление"
            ]
          },
          "set": {
            "approved": true
          },
          "text": "Владелец согласовал роль «читатель»."
        },
        {
          "when": true,
          "set": {
            "approved": false
          },
          "text": "Очередь инцидентов не согласовала новый объём прав."
        }
      ]
    },
    {
      "id": "create",
      "label": "Создать учётную запись",
      "outcomes": [
        {
          "when": true,
          "set": {
            "account": true,
            "access": "не выполнена"
          },
          "text": "Объект учётной записи создан; роль {role}."
        }
      ]
    },
    {
      "id": "admin",
      "label": "Назначить администратора",
      "outcomes": [
        {
          "when": true,
          "set": {
            "role": "администратор",
            "excess": true,
            "access": "не выполнена"
          },
          "text": "Пользователю выданы избыточные права."
        }
      ]
    },
    {
      "id": "revoke",
      "label": "Отозвать избыточную роль",
      "visible": {
        "op": "eq",
        "args": [
          {
            "ref": "excess"
          },
          true
        ]
      },
      "outcomes": [
        {
          "when": true,
          "set": {
            "role": "нет",
            "excess": false,
            "access": "не выполнена"
          },
          "text": "Избыточные права сняты."
        }
      ]
    },
    {
      "id": "grant",
      "label": "Назначить согласованного читателя",
      "requires": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "approved"
              },
              true
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "ref": "account"
              },
              true
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "ref": "excess"
              },
              false
            ]
          }
        ]
      },
      "blocked": "Нужны согласование, учётная запись и отзыв избыточных прав.",
      "outcomes": [
        {
          "when": true,
          "set": {
            "role": "читатель",
            "access": "не выполнена"
          },
          "text": "Роль читателя назначена."
        }
      ]
    },
    {
      "id": "test",
      "label": "Выполнить чтение от пользователя",
      "outcomes": [
        {
          "when": true,
          "set": {
            "access": {
              "op": "if",
              "args": [
                {
                  "op": "and",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "ref": "account"
                        },
                        true
                      ]
                    },
                    {
                      "op": "ne",
                      "args": [
                        {
                          "ref": "role"
                        },
                        "нет"
                      ]
                    }
                  ]
                },
                "доступно",
                "отказ доступа"
              ]
            }
          },
          "text": "Пользовательское чтение: {access}. Фактическая роль: {role}."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "excess"
          },
          true
        ]
      },
      "text": "Чтение может работать, но выданы права администратора. Назначение читателя не отменит избыточную роль без отзыва."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "queue"
          },
          "инциденты"
        ]
      },
      "text": "Заявка попала в восстановление утраченного доступа. Здесь не согласуют новую роль."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "access"
          },
          "отказ доступа"
        ]
      },
      "text": "Аккаунт существует без нужной роли. Требуется согласованное назначение и новый тест."
    },
    {
      "when": true,
      "text": "Маршрут {queue}; аккаунт {account}; роль {role}; чтение {access}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "queue"
          },
          "предоставление"
        ]
      },
      "text": "Выбран маршрут новой услуги"
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "role"
              },
              "читатель"
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "ref": "excess"
              },
              false
            ]
          }
        ]
      },
      "text": "Выданы только согласованные права"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "access"
          },
          "доступно"
        ]
      },
      "text": "Нужная функция доступна"
    }
  ],
  "debrief": "Тип заявки меняет получателя согласования; создание аккаунта не назначает роль. Избыточное право требуется отозвать отдельно.",
  "title": "Маршрутизация по типу и влиянию",
  "condition": "Пользователь просит новую учётную запись; доступных функций он не потерял."
}
