  "revision": 2,
  "initial": {
    "local": true,
    "remote": false,
    "disk": "работает",
    "restored": false,
    "lossRecorded": false,
    "newCycle": false
  },
  "fields": [
    {
      "key": "local",
      "label": "Локальные копии доступны"
    },
    {
      "key": "remote",
      "label": "Независимая проверенная копия"
    },
    {
      "key": "disk",
      "label": "Исходный диск"
    },
    {
      "key": "restored",
      "label": "Данные восстановлены"
    },
    {
      "key": "lossRecorded",
      "label": "Потеря данных зафиксирована"
    },
    {
      "key": "newCycle",
      "label": "Новый защищённый цикл создан"
    }
  ],
  "computed": {},
  "lectureId": "s07-10-backup-restore",
  "questionId": "s07-10-backup-restore-Q05",
  "goal": "Подготовить независимое хранение и проверить переживание отказа диска.",
  "rules": [
    "Локальные копии создаются каждые 10 минут на одном диске с данными.",
    "Отказ диска уничтожает все находящиеся на нём копии. При их отсутствии цель — честно зафиксировать невосстановимость и подготовить защищённый новый цикл."
  ],
  "actions": [
    {
      "id": "remote",
      "label": "Перенести и проверить копию на независимом носителе",
      "requires": {
        "op": "eq",
        "args": [
          {
            "ref": "local"
          },
          true
        ]
      },
      "blocked": "После потери локальных данных копировать их уже нельзя.",
      "outcomes": [
        {
          "when": true,
          "set": {
            "remote": true
          },
          "text": "Независимая копия проверена."
        }
      ]
    },
    {
      "id": "more",
      "label": "Создать ещё шесть копий на том же диске",
      "requires": {
        "op": "eq",
        "args": [
          {
            "ref": "disk"
          },
          "работает"
        ]
      },
      "blocked": "Исходный диск утрачен.",
      "outcomes": [
        {
          "when": true,
          "set": {
            "local": true
          },
          "text": "Шесть новых копий остаются в том же домене отказа."
        }
      ]
    },
    {
      "id": "fail",
      "label": "Проиграть полный отказ исходного диска",
      "outcomes": [
        {
          "when": true,
          "set": {
            "disk": "утрачен",
            "local": false,
            "restored": false
          },
          "text": "Исходный диск утрачен вместе со всеми локальными копиями."
        }
      ]
    },
    {
      "id": "restore",
      "label": "Восстановить с независимого носителя",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "remote"
              },
              true
            ]
          },
          "set": {
            "restored": true
          },
          "text": "Данные доступны из независимой копии."
        },
        {
          "when": true,
          "set": {
            "restored": false,
            "lossRecorded": true
          },
          "text": "Ни одной сохранившейся копии нет; прежние данные восстановить нечем."
        }
      ]
    },
    {
      "id": "record",
      "label": "Зафиксировать невосстановимую потерю",
      "requires": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "disk"
              },
              "утрачен"
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "ref": "remote"
              },
              false
            ]
          }
        ]
      },
      "blocked": "Есть другой доступный маршрут или отказ ещё не произошёл.",
      "outcomes": [
        {
          "when": true,
          "set": {
            "lossRecorded": true
          },
          "text": "Потеря зарегистрирована; данные не выдуманы."
        }
      ]
    },
    {
      "id": "new",
      "label": "Создать новый цикл с независимым хранением",
      "requires": {
        "op": "eq",
        "args": [
          {
            "ref": "lossRecorded"
          },
          true
        ]
      },
      "blocked": "Сначала зафиксируйте последствия потери.",
      "outcomes": [
        {
          "when": true,
          "set": {
            "newCycle": true
          },
          "text": "На новом носителе подготовлен независимый цикл будущих копий. Старые потерянные данные не восстановлены."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "disk"
              },
              "утрачен"
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "ref": "remote"
              },
              false
            ]
          }
        ]
      },
      "text": "Диск и все прежние копии потеряны. Доступен маршрут учёта потери и защиты будущих данных; возврата старых данных из ничего нет."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "restored"
          },
          true
        ]
      },
      "text": "Независимая копия пережила отказ; данные восстановлены."
    },
    {
      "when": true,
      "text": "Локальные копии {local}; независимая копия {remote}. Можно испытать отказ диска."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "or",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "restored"
              },
              true
            ]
          },
          {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "lossRecorded"
                  },
                  true
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "newCycle"
                  },
                  true
                ]
              }
            ]
          }
        ]
      },
      "text": "Данные восстановлены либо потеря явно обработана и будущий цикл защищён"
    }
  ],
  "debrief": "Частота и независимость хранения — разные свойства. Компенсация необратимой потери означает учёт последствий, а не магическое восстановление.",
  "title": "Расписание и хранение",
  "condition": "Копии создаются каждые 10 минут, но остаются на том же единственном диске."
}
