{
  "id": "s07-07-knowledge-base-Q08-case",
  "revision": 2,
  "initial": {
    "views": 100,
    "denominator": 100,
    "rate": 12,
    "report": 0
  },
  "fields": [
    {
      "key": "views",
      "label": "Просмотры"
    },
    {
      "key": "denominator",
      "label": "Выбранный знаменатель"
    },
    {
      "key": "rate",
      "label": "Успешность",
      "unit": "%"
    },
    {
      "key": "report",
      "label": "Опубликованный показатель",
      "unit": "%"
    }
  ],
  "computed": {
    "rate": {
      "op": "mul",
      "args": [
        {
          "op": "div",
          "args": [
            12,
            {
              "ref": "denominator"
            }
          ]
        },
        100
      ]
    }
  },
  "lectureId": "s07-07-knowledge-base",
  "questionId": "s07-07-knowledge-base-Q08",
  "goal": "Получить успешность применения по подходящим попыткам и исправить опубликованный показатель.",
  "rules": [
    "100 просмотров, 30 подходящих попыток, 12 успехов. Рост просмотров до 200 не меняет число применений."
  ],
  "actions": [
    {
      "id": "views",
      "label": "Использовать просмотры как знаменатель",
      "outcomes": [
        {
          "when": true,
          "set": {
            "denominator": {
              "ref": "views"
            }
          },
          "text": "Показатель теперь {rate}%; это доля от просмотров."
        }
      ]
    },
    {
      "id": "attempts",
      "label": "Использовать 30 подходящих попыток",
      "outcomes": [
        {
          "when": true,
          "set": {
            "denominator": 30
          },
          "text": "Успешность применения {rate}%."
        }
      ]
    },
    {
      "id": "grow",
      "label": "Довести просмотры до 200",
      "outcomes": [
        {
          "when": true,
          "set": {
            "views": 200
          },
          "text": "Просмотры выросли; попытки 30 и успехи 12 не изменились."
        }
      ]
    },
    {
      "id": "publish",
      "label": "Опубликовать текущий показатель",
      "outcomes": [
        {
          "when": true,
          "set": {
            "report": {
              "ref": "rate"
            }
          },
          "text": "Опубликовано {report}%."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "ne",
        "args": [
          {
            "ref": "denominator"
          },
          30
        ]
      },
      "text": "Знаменатель {denominator} описывает просмотры; рост просмотров искусственно меняет такой показатель."
    },
    {
      "when": {
        "op": "ne",
        "args": [
          {
            "ref": "report"
          },
          40
        ]
      },
      "text": "Расчёт 40%, но ранее опубликованный показатель {report}% ещё не заменён."
    },
    {
      "when": true,
      "text": "Успешность применения 40%; просмотров {views}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "denominator"
          },
          30
        ]
      },
      "text": "Выбран подходящий знаменатель"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "report"
          },
          40
        ]
      },
      "text": "Опубликована успешность 40%"
    }
  ],
  "debrief": "Рост другого счётчика не меняет применимость статьи. Локальный расчёт не заменяет отправленный отчёт.",
  "title": "Актуальность и метрики",
  "condition": "Статью просмотрели 100 раз, успешно применили 12 из 30 подходящих попыток."
}
