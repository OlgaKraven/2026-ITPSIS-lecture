{
  "id": "s07-01-support-lifecycle-Q05-case",
  "revision": 2,
  "initial": {
    "card": "только DOC-02",
    "generator": "остановлен",
    "ping": "не проверен",
    "document": "не проверен",
    "accepted": false
  },
  "fields": [
    {
      "key": "card",
      "label": "Карточка каталога"
    },
    {
      "key": "generator",
      "label": "Генератор PDF"
    },
    {
      "key": "ping",
      "label": "Ответ ping"
    },
    {
      "key": "document",
      "label": "Результат услуги"
    },
    {
      "key": "accepted",
      "label": "Услуга принята"
    }
  ],
  "computed": {},
  "lectureId": "s07-01-support-lifecycle",
  "questionId": "s07-01-support-lifecycle-Q05",
  "goal": "Связать компонент DOC-02 с услугой выдачи справок и проверить пользовательский результат.",
  "rules": [
    "Ping подтверждает сетевой ответ DOC-02. Для выдачи требуется работающий генератор PDF."
  ],
  "actions": [
    {
      "id": "card",
      "label": "Указать потребителей и выдачу справки",
      "outcomes": [
        {
          "when": true,
          "set": {
            "card": "деканат — выдача справок — DOC-02"
          },
          "text": "Каталог связывает потребителя, результат и компонент."
        }
      ]
    },
    {
      "id": "ping",
      "label": "Проверить ping",
      "outcomes": [
        {
          "when": true,
          "set": {
            "ping": "успех"
          },
          "text": "DOC-02 отвечает на ping."
        }
      ]
    },
    {
      "id": "accept",
      "label": "Принять услугу по ping",
      "outcomes": [
        {
          "when": true,
          "set": {
            "accepted": true
          },
          "text": "Услуга принята по компонентной проверке; генератор {generator}."
        }
      ]
    },
    {
      "id": "request",
      "label": "Сформировать справку",
      "outcomes": [
        {
          "when": true,
          "set": {
            "document": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "generator"
                    },
                    "работает"
                  ]
                },
                "справка получена",
                "ошибка генератора"
              ]
            },
            "accepted": false
          },
          "text": "Результат запроса: {document}."
        }
      ]
    },
    {
      "id": "start",
      "label": "Запустить генератор PDF",
      "outcomes": [
        {
          "when": true,
          "set": {
            "generator": "работает",
            "document": "не проверен",
            "accepted": false
          },
          "text": "Генератор запущен; нужен новый запрос."
        }
      ]
    },
    {
      "id": "verify",
      "label": "Принять услугу по справке",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "card"
                  },
                  "деканат — выдача справок — DOC-02"
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "document"
                  },
                  "справка получена"
                ]
              }
            ]
          },
          "set": {
            "accepted": true
          },
          "text": "Услуга принята по результату для потребителя."
        },
        {
          "when": true,
          "set": {
            "accepted": false
          },
          "text": "Нет связи услуги с потребителем или результата выдачи."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "document"
          },
          "ошибка генератора"
        ]
      },
      "text": "Компонент доступен, генератор остановлен. Пользовательская услуга не работает."
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "accepted"
              },
              true
            ]
          },
          {
            "op": "ne",
            "args": [
              {
                "ref": "document"
              },
              "справка получена"
            ]
          }
        ]
      },
      "text": "Ping не проверил выдачу справки. Выполните пользовательскую операцию."
    },
    {
      "when": true,
      "text": "Карточка: {card}. Генератор {generator}; услуга: {document}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "card"
          },
          "деканат — выдача справок — DOC-02"
        ]
      },
      "text": "В каталоге описана услуга"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "document"
          },
          "справка получена"
        ]
      },
      "text": "Получен пользовательский результат"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "accepted"
          },
          true
        ]
      },
      "text": "Услуга принята"
    }
  ],
  "debrief": "Исправление каталога не запускает генератор, а доступность сервера не формирует справку.",
  "title": "Каталог сопровождаемых услуг",
  "condition": "В каталоге указано только «сервер DOC-02», пользователи и результат отсутствуют."
}
