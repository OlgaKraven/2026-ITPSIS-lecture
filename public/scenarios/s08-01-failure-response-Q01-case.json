                        true
                      ]
                    },
                    {
                      "op": "eq",
                      "args": [
                        {
                          "ref": "nodeB"
                        },
                        "отказ"
                      ]
                    }
                  ]
                },
                50,
                0
              ]
            },
            "accepted": {
              "op": "not",
              "args": [
                {
                  "op": "and",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "ref": "pool"
                        },
                        true
                      ]
                    },
                    {
                      "op": "eq",
                      "args": [
                        {
                          "ref": "nodeB"
                        },
                        "отказ"
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "text": "Выборка: {errors} ошибок из 100."
        }
      ]
    }
