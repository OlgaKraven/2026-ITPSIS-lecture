    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "pool"
              },
              true
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "ref": "nodeB"
              },
              "отказ"
            ]
          }
        ]
      },
      "text": "Узел B принимает половину трафика и возвращает ошибки."
    },
    {
      "when": true,
      "text": "B {nodeB}, в балансировке {pool}; выборка {errors}/100."
