  ],
  "actions": [
    {
      "id": "ping",
      "label": "Проверить главную страницу",
      "outcomes": [
        {
          "when": true,
          "set": {
            "portal": "отвечает"
          },
          "text": "Главная страница отвечает, маршрут целевой операции не изменился."
        }
      ]
    },
    {
      "id": "accept",
      "label": "Закрыть отказ по ответу портала",
      "outcomes": [
        {
          "when": true,
          "set": {
            "accepted": true
          },
          "text": "Услуга принята при {errors} отказах из 100."
        }
      ]
    },
    {
      "id": "out",
      "label": "Вывести B из балансировки",
      "outcomes": [
        {
          "when": true,
          "set": {
            "pool": false,
            "accepted": false
          },
          "text": "Трафик направлен на исправный A; прежняя выборка ещё не обновлена."
        }
      ]
    },
    {
      "id": "fix",
      "label": "Восстановить узел B",
      "outcomes": [
        {
          "when": true,
          "set": {
            "nodeB": "работает",
            "accepted": false
          },
          "text": "Узел B восстановлен."
