{
  "id": "s08-02-error-collection-Q01-case",
  "revision": 2,
  "initial": {
    "filter": "только минута",
    "selected": "нет",
    "direction": "нет",
    "linked": false
  },
  "fields": [
    {
      "key": "filter",
      "label": "Фильтр поиска"
    },
    {
      "key": "selected",
      "label": "Выбранный запрос"
    },
    {
      "key": "direction",
      "label": "Направление анализа"
    },
    {
      "key": "linked",
      "label": "Связь подтверждена"
    }
  ],
  "computed": {},
  "lectureId": "s08-02-error-collection",
  "questionId": "s08-02-error-collection-Q01",
  "goal": "Связать сообщение с одной операцией и не направить диагностику по чужому запросу.",
  "rules": [
    "В минутном окне 40 запросов. Нужный пользовательский запрос — R42 с операцией «выдача». По времени первым находится R17 «вход»."
  ],
  "actions": [
    {
      "id": "time",
      "label": "Выбрать первую строку минутного окна",
      "outcomes": [
        {
          "when": true,
          "set": {
            "selected": "R17",
            "linked": false
          },
          "text": "Выбран R17: операция входа другого пользователя."
        }
      ]
    },
    {
      "id": "context",
      "label": "Добавить операцию и разрешённый идентификатор пользователя",
      "outcomes": [
        {
          "when": true,
          "set": {
            "filter": "минута + выдача + пользователь"
          },
          "text": "Выборка ограничена контекстом пользователя."
        }
      ]
    },
    {
      "id": "search",
      "label": "Повторить поиск",
      "outcomes": [
        {
          "when": true,
          "set": {
            "selected": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "filter"
                    },
                    "минута + выдача + пользователь"
                  ]
                },
                "R42",
                "R17"
              ]
            },
            "linked": false
          },
          "text": "Найден {selected}."
        }
      ]
    },
    {
      "id": "analyse",
      "label": "Выполнить анализ выбранного следа",
      "outcomes": [
        {
          "when": true,
          "set": {
            "direction": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "selected"
                    },
                    "R42"
                  ]
                },
                "генератор справки",
                "аутентификация"
              ]
            },
            "linked": {
              "op": "eq",
              "args": [
                {
                  "ref": "selected"
                },
                "R42"
              ]
            }
          },
          "text": "Диагностика направлена на {direction}; связь с обращением {linked}."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "selected"
          },
          "R17"
        ]
      },
      "text": "Взята другая операция: вход вместо выдачи. Следующее исследование уйдёт в аутентификацию."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "linked"
          },
          true
        ]
      },
      "text": "Контекст и ID связывают сообщение с выдачей справки."
    },
    {
      "when": true,
      "text": "Фильтр {filter}; запрос {selected}; направление {direction}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "linked"
          },
          true
        ]
      },
      "text": "Связана конкретная операция"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "direction"
          },
          "генератор справки"
        ]
      },
      "text": "Диагностика использует нужный след"
    }
  ],
  "debrief": "Фильтр меняет найденный набор, выбор — дальнейшее направление анализа.",
  "title": "Обращение пользователя как источник",
  "condition": "Пользователь назвал время ошибки с точностью до минуты и свою операцию."
}
