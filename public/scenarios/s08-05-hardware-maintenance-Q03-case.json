      ]
    },
    {
      "id": "cool",
      "label": "Выполнить разрешённое обслуживание охлаждения",
      "outcomes": [
        {
          "when": true,
          "set": {
            "cooling": true,
            "temp": 65,
            "tested": false
          },
          "text": "Охлаждение обслужено; температура 65 °C."
        }
      ]
    },
    {
      "id": "test",
      "label": "Провести контрольный интервал под нагрузкой",
      "outcomes": [
        {
          "when": true,
          "set": {
