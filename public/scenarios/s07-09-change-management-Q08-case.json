                6,
                3
              ]
            },
            "report": "измерено в сопоставимых условиях",
            "accepted": false
          },
          "text": "Измерено {duration} минут."
        }
      ]
    },
    {
      "id": "rollback",
      "label": "Выполнить предусмотренный возврат",
      "outcomes": [
        {
          "when": true,
          "set": {
            "version": "старая",
            "accepted": false
          },
          "text": "Версия возвращена; нужен новый замер."
        }
      ]
    },
    {
      "id": "explain",
      "label": "Объяснить ухудшение другой нагрузкой",
      "outcomes": [
        {
          "when": true,
          "set": {
            "load": false,
            "report": "непроверенная причина"
          },
          "text": "Причина объявлена без сопоставимого измерения."
        }
      ]
    },
    {
      "id": "same",
      "label": "Вернуть сопоставимую тестовую нагрузку",
      "outcomes": [
        {
          "when": true,
          "set": {
            "load": true
          },
          "text": "Условия измерения сопоставимы."
        }
      ]
    },
    {
      "id": "accept",
      "label": "Принять результат по цели",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "version"
                  },
                  "старая"
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "duration"
                  },
                  3
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "load"
                  },
                  true
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "report"
                  },
                  "измерено в сопоставимых условиях"
                ]
              }
            ]
          },
          "set": {
            "accepted": true,
            "report": "возврат восстановил целевой результат"
          },
          "text": "Возврат восстановил 3 минуты; релиз не принят как улучшение."
        },
        {
          "when": true,
          "set": {
            "accepted": false
          },
          "text": "Пользовательская цель не подтверждена."
        }
      ]
    }
  ],
  "scenes": [
    {
