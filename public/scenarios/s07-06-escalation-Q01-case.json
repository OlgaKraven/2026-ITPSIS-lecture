{
  "id": "s07-06-escalation-Q01-case",
  "revision": 2,
  "initial": {
    "queue": "L1",
    "task": false,
    "owner": "нет",
    "trace": false
  },
  "fields": [
    {
      "key": "queue",
      "label": "Получатель"
    },
    {
      "key": "task",
      "label": "Поручение с requestId задано"
    },
    {
      "key": "owner",
      "label": "Исполнитель"
    },
    {
      "key": "trace",
      "label": "Трассировка получена"
    }
  ],
  "computed": {},
  "lectureId": "s07-06-escalation",
  "questionId": "s07-06-escalation-Q01",
  "goal": "Получить трассировку от названного исполнителя L2.",
  "rules": [
    "У L1 нет доступа к трассировке, у L2 есть. Письмо без поручения не назначает исполнителя."
  ],
  "actions": [
    {
      "id": "l1",
      "label": "Оставить анализ трассировки L1",
      "outcomes": [
        {
          "when": true,
          "set": {
            "queue": "L1",
            "owner": "L1"
          },
          "text": "L1 взял задачу, но доступа к источнику у него нет."
        }
      ]
    },
    {
      "id": "l2",
      "label": "Направить пакет L2",
      "outcomes": [
        {
          "when": true,
          "set": {
            "queue": "L2",
            "owner": "нет"
          },
          "text": "Пакет доставлен L2; исполнитель пока не назван."
        }
      ]
    },
    {
      "id": "task",
      "label": "Задать requestId, вопрос и срок",
      "outcomes": [
        {
          "when": true,
          "set": {
            "task": true
          },
          "text": "Поручение позволяет искать конкретный след."
        }
      ]
    },
    {
      "id": "accept",
      "label": "Получить принятие",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "queue"
                  },
                  "L2"
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "task"
                  },
                  true
                ]
              }
            ]
          },
          "set": {
            "owner": "инженер L2"
          },
          "text": "Инженер L2 подтвердил задачу и срок."
        },
        {
          "when": true,
          "set": {
            "owner": "нет"
          },
          "text": "Нет компетентного получателя или исполнимого поручения."
        }
      ]
    },
    {
      "id": "read",
      "label": "Запросить трассировку у текущего исполнителя",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "owner"
              },
              "инженер L2"
            ]
          },
          "set": {
            "trace": true
          },
          "text": "L2 выгрузил трассировку указанного requestId."
        },
        {
          "when": true,
          "set": {
            "trace": false
          },
          "text": "След не получен: исполнитель {owner} не имеет принятого поручения с нужным доступом."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "owner"
          },
          "L1"
        ]
      },
      "text": "У L1 назначение есть, доступа нет. Повтор чтения не выдаст права к трассировке."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "owner"
          },
          "нет"
        ]
      },
      "text": "Пакет ещё не принят названным исполнителем."
    },
    {
      "when": true,
      "text": "Исполнитель {owner}; трассировка {trace}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "owner"
          },
          "инженер L2"
        ]
      },
      "text": "Назван компетентный исполнитель"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "trace"
          },
          true
        ]
      },
      "text": "Получен след нужной операции"
    }
  ],
  "debrief": "Эскалация меняет исполнителя, принятие закрепляет поручение; получение письма не делает трассировку доступной L1.",
  "title": "Функциональная эскалация",
  "condition": "L1 не имеет доступа к трассировке, L2 имеет и умеет её читать."
}
