{
  "id": "s07-06-escalation-Q05-case",
  "revision": 2,
  "initial": {
    "task": "нет",
    "id": "нет",
    "finding": "нет",
    "linked": false
  },
  "fields": [
    {
      "key": "task",
      "label": "Поручение"
    },
    {
      "key": "id",
      "label": "Идентификатор в ответе"
    },
    {
      "key": "finding",
      "label": "Результат"
    },
    {
      "key": "linked",
      "label": "Ответ связан с обращением"
    }
  ],
  "computed": {},
  "lectureId": "s07-06-escalation",
  "questionId": "s07-06-escalation-Q05",
  "goal": "Получить ответ по нужному requestId с проверяемым действием.",
  "rules": [
    "В архиве есть ошибки запросов R17 и R42; обращение относится к R42. Версия и логи без вопроса не задают работу."
  ],
  "actions": [
    {
      "id": "send",
      "label": "Отправить логи без задания",
      "outcomes": [
        {
          "when": true,
          "set": {
            "task": "архив без вопроса",
            "id": "R17",
            "finding": "найдена посторонняя ошибка",
            "linked": false
          },
          "text": "Адресат вернул первую найденную ошибку R17."
        }
      ]
    },
    {
      "id": "task",
      "label": "Задать вопрос о R42 и критерий ответа",
      "outcomes": [
        {
          "when": true,
          "set": {
            "task": "проверка R42"
          },
          "text": "Поручение относится к операции обращения."
        }
      ]
    },
    {
      "id": "work",
      "label": "Выполнить поручение по архиву",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "task"
              },
              "проверка R42"
            ]
          },
          "set": {
            "id": "R42",
            "finding": "ожидание внешнего API",
            "linked": false
          },
          "text": "Найден след R42: ожидание API."
        },
        {
          "when": true,
          "set": {
            "id": "R17",
            "finding": "найдена посторонняя ошибка",
            "linked": false
          },
          "text": "Без вопроса адресат исследовал R17."
        }
      ]
    },
    {
      "id": "link",
      "label": "Сопоставить ответ с ID обращения",
      "outcomes": [
        {
          "when": true,
          "set": {
            "linked": {
              "op": "eq",
              "args": [
                {
                  "ref": "id"
                },
                "R42"
              ]
            }
          },
          "text": "Связь ответа с обращением R42: {linked}."
        }
      ]
    },
    {
      "id": "omit",
      "label": "Удалить requestId из ответа",
      "outcomes": [
        {
          "when": true,
          "set": {
            "id": "нет",
            "linked": false
          },
          "text": "Результат больше нельзя уверенно связать с конкретной операцией."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "id"
          },
          "R17"
        ]
      },
      "text": "Найдена ошибка другого запроса. Это меняет направление работы; требуется поручение по R42."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "id"
          },
          "нет"
        ]
      },
      "text": "В ответе нет ключа корреляции; запросите результат с идентификатором."
    },
    {
      "when": true,
      "text": "Задание {task}; ответ {id}: {finding}; связь {linked}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "linked"
          },
          true
        ]
      },
      "text": "Ответ относится к нужной операции"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "finding"
          },
          "ожидание внешнего API"
        ]
      },
      "text": "Получен конкретный результат"
    }
  ],
  "debrief": "Наличие ошибки в архиве не доказывает её принадлежность обращению.",
  "title": "Состав пакета",
  "condition": "Есть логи и версия, но не указано, что требуется от получателя."
}
