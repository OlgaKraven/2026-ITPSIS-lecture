{
  "id": "s07-01-support-lifecycle-Q08-case",
  "revision": 2,
  "initial": {
    "queue": 36,
    "tool": "не работает",
    "completed": 0,
    "days": 0,
    "ratio": 2
  },
  "fields": [
    {
      "key": "queue",
      "label": "Остаток очереди"
    },
    {
      "key": "tool",
      "label": "Средство диагностики"
    },
    {
      "key": "completed",
      "label": "Завершено за последний день"
    },
    {
      "key": "days",
      "label": "Наблюдаемых дней"
    },
    {
      "key": "ratio",
      "label": "Рост к исходным 18"
    }
  ],
  "computed": {
    "ratio": {
      "op": "div",
      "args": [
        {
          "ref": "queue"
        },
        18
      ]
    }
  },
  "lectureId": "s07-01-support-lifecycle",
  "questionId": "s07-01-support-lifecycle-Q08",
  "goal": "Устранить ограничение диагностики и остановить рост очереди по балансу потока.",
  "rules": [
    "Очередь выросла с 18 до 36. В следующем сравнимом дне поступает 18 обращений. Без диагностики завершается 9, с исправной диагностикой — 18."
  ],
  "actions": [
    {
      "id": "day",
      "label": "Провести следующий сравнимый рабочий день",
      "outcomes": [
        {
          "when": true,
          "set": {
            "completed": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "tool"
                    },
                    "работает"
                  ]
                },
                18,
                9
              ]
            },
            "queue": {
              "op": "add",
              "args": [
                {
                  "ref": "queue"
                },
                {
                  "op": "if",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "ref": "tool"
                        },
                        "работает"
                      ]
                    },
                    0,
                    9
                  ]
                }
              ]
            },
            "days": {
              "op": "add",
              "args": [
                {
                  "ref": "days"
                },
                1
              ]
            }
          },
          "text": "За день завершено {completed}; очередь {queue}; отношение к 18 составляет {ratio}."
        }
      ]
    },
    {
      "id": "paper",
      "label": "Переназвать задачи без восстановления диагностики",
      "outcomes": [
        {
          "when": true,
          "set": {},
          "text": "Названия изменены; пропускная способность и очередь не изменились."
        }
      ]
    },
    {
      "id": "repair",
      "label": "Восстановить средство диагностики",
      "outcomes": [
        {
          "when": true,
          "set": {
            "tool": "работает"
          },
          "text": "Диагностика работает. Уже накопленная очередь остаётся {queue}."
        }
      ]
    },
    {
      "id": "drain",
      "label": "Выделить согласованную смену на накопленный остаток",
      "requires": {
        "op": "eq",
        "args": [
          {
            "ref": "tool"
          },
          "работает"
        ]
      },
      "blocked": "Без исправной диагностики смена не может обработать сложные обращения.",
      "outcomes": [
        {
          "when": true,
          "set": {
            "queue": 18
          },
          "text": "Накопленный остаток разобран дополнительной согласованной сменой."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "gte",
        "args": [
          {
            "ref": "queue"
          },
          37
        ]
      },
      "text": "Очередь растёт при неизменном входящем потоке. Диагностика: {tool}; накоплено {queue}."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "tool"
          },
          "не работает"
        ]
      },
      "text": "Приход 18, обработка 9. Следующий день добавит 9 обращений."
    },
    {
      "when": true,
      "text": "Ограничение устранено. Накопленный остаток {queue} нужно разбирать отдельно."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "tool"
          },
          "работает"
        ]
      },
      "text": "Диагностика восстановлена"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "queue"
          },
          18
        ]
      },
      "text": "Накопленный остаток разобран"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "completed"
          },
          18
        ]
      },
      "text": "Проверена прежняя пропускная способность"
    }
  ],
  "debrief": "Восстановление инструмента меняет будущую обработку, но не удаляет накопленные обращения.",
  "title": "Пересмотр сопровождения",
  "condition": "Остаток очереди растёт, пользователи ждут дольше, число инженеров прежнее. Сопоставимые измерения приведены на первом шаге."
}
