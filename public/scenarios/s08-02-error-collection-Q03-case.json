{
  "id": "s08-02-error-collection-Q03-case",
  "revision": 2,
  "initial": {
    "filter": "ERROR",
    "event": "нет",
    "package": "не передан"
  },
  "fields": [
    {
      "key": "filter",
      "label": "Поиск"
    },
    {
      "key": "event",
      "label": "Выбранное событие"
    },
    {
      "key": "package",
      "label": "Пакет"
    }
  ],
  "computed": {},
  "lectureId": "s08-02-error-collection",
  "questionId": "s08-02-error-collection-Q03",
  "goal": "Выбрать ERROR нужной версии и запроса и передать его для анализа.",
  "rules": [
    "Обращение — версия 5, R42, 10:05. В архиве первая ERROR относится к версии 4, R17, 09:05."
  ],
  "actions": [
    {
      "id": "first",
      "label": "Выбрать первую ERROR",
      "outcomes": [
        {
          "when": true,
          "set": {
            "event": "версия 4 / R17 / 09:05"
          },
          "text": "Выбрана ошибка другой версии на час раньше."
        }
      ]
    },
    {
      "id": "fields",
      "label": "Добавить версию 5, R42 и время",
      "outcomes": [
        {
          "when": true,
          "set": {
            "filter": "ERROR + версия 5 + R42 + 10:05"
          },
          "text": "Фильтр ограничен нужной операцией."
        }
      ]
    },
    {
      "id": "search",
      "label": "Выполнить поиск",
      "outcomes": [
        {
          "when": true,
          "set": {
            "event": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "filter"
                    },
                    "ERROR + версия 5 + R42 + 10:05"
                  ]
                },
                "версия 5 / R42 / 10:05",
                "версия 4 / R17 / 09:05"
              ]
            }
          },
          "text": "Найдено: {event}."
        }
      ]
    },
    {
      "id": "send",
      "label": "Передать выбранное событие",
      "outcomes": [
        {
          "when": true,
          "set": {
            "package": {
              "ref": "event"
            }
          },
          "text": "Передано: {package}."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "package"
          },
          "версия 4 / R17 / 09:05"
        ]
      },
      "text": "Получатель исследует посторонний ERROR. Исправление локального фильтра не заменит переданный пакет."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "event"
          },
          "версия 4 / R17 / 09:05"
        ]
      },
      "text": "Уровень ERROR не доказывает принадлежность обращению."
    },
    {
      "when": true,
      "text": "Фильтр {filter}; событие {event}; пакет {package}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "package"
          },
          "версия 5 / R42 / 10:05"
        ]
      },
      "text": "Передан след нужной версии и операции"
    }
  ],
  "debrief": "Версия, время и ID ограничивают принадлежность события. Отправка использует выбранный след.",
  "title": "Журнал приложения",
  "condition": "В логе есть уровень ERROR без версии приложения и requestId."
}
