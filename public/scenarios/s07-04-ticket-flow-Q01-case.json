{
  "id": "s07-04-ticket-flow-Q01-case",
  "revision": 2,
  "initial": {
    "filter": "скрывает запись",
    "row": "есть",
    "route": "не выбрано",
    "visible": false
  },
  "fields": [
    {
      "key": "filter",
      "label": "Фильтр интерфейса"
    },
    {
      "key": "row",
      "label": "Запись в БД"
    },
    {
      "key": "route",
      "label": "Направление проверки"
    },
    {
      "key": "visible",
      "label": "Номер виден"
    }
  ],
  "computed": {},
  "lectureId": "s07-04-ticket-flow",
  "questionId": "s07-04-ticket-flow-Q01",
  "goal": "Вернуть видимость номера заявки, сохранив наблюдение отдельно от диагноза.",
  "rules": [
    "Запись есть в БД; интерфейс скрывает её активным фильтром. Изменение БД не требуется."
  ],
  "actions": [
    {
      "id": "db",
      "label": "Удалить подозреваемую строку БД",
      "outcomes": [
        {
          "when": true,
          "set": {
            "row": "удалена",
            "visible": false,
            "route": "БД"
          },
          "text": "Строка удалена по недоказанному диагнозу; номер теперь отсутствует и в БД."
        }
      ]
    },
    {
      "id": "inspect",
      "label": "Сопоставить ID с БД и фильтром",
      "outcomes": [
        {
          "when": true,
          "set": {
            "route": "интерфейс"
          },
          "text": "Проверяется та же заявка; фильтр {filter}, строка {row}."
        }
      ]
    },
    {
      "id": "filter",
      "label": "Снять скрывающий фильтр",
      "outcomes": [
        {
          "when": true,
          "set": {
            "filter": "все заявки",
            "visible": false
          },
          "text": "Фильтр снят; данные БД не изменены."
        }
      ]
    },
    {
      "id": "restore",
      "label": "Восстановить удалённую строку из журнала",
      "outcomes": [
        {
          "when": true,
          "set": {
            "row": "есть",
            "visible": false
          },
          "text": "Запись возвращена с прежним ID."
        }
      ]
    },
    {
      "id": "view",
      "label": "Открыть список заявок",
      "outcomes": [
        {
          "when": true,
          "set": {
            "visible": {
              "op": "and",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "row"
                    },
                    "есть"
                  ]
                },
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "filter"
                    },
                    "все заявки"
                  ]
                }
              ]
            }
          },
          "text": "Видимость номера: {visible}."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "row"
          },
          "удалена"
        ]
      },
      "text": "Удаление строки создало дополнительную потерю данных. Снятие фильтра не вернёт запись."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "filter"
          },
          "скрывает запись"
        ]
      },
      "text": "Номер скрыт интерфейсным фильтром. Запись в БД: {row}."
    },
    {
      "when": true,
      "text": "Фильтр {filter}; номер виден {visible}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "row"
          },
          "есть"
        ]
      },
      "text": "Исходная запись сохранена"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "visible"
          },
          true
        ]
      },
      "text": "Пользователь видит номер"
    }
  ],
  "debrief": "Действие по ложному диагнозу меняет данные. Исправление фильтра и восстановление строки устраняют разные последствия.",
  "title": "Первичный контакт",
  "condition": "Пользователь сказал «после отправки пропал номер». Оператор записал «сломана база»."
}
