{
  "id": "s07-02-support-levels-Q07-case",
  "revision": 2,
  "initial": {
    "history": false,
    "owner": "старая смена",
    "accepted": false,
    "lost": 0,
    "next": "не выбрана"
  },
  "fields": [
    {
      "key": "history",
      "label": "История тестов передана"
    },
    {
      "key": "owner",
      "label": "Ответственный"
    },
    {
      "key": "accepted",
      "label": "Новая смена приняла"
    },
    {
      "key": "lost",
      "label": "Время повторной проверки",
      "unit": "мин"
    },
    {
      "key": "next",
      "label": "Следующая проверка"
    }
  ],
  "computed": {},
  "lectureId": "s07-02-support-levels",
  "questionId": "s07-02-support-levels-Q07",
  "goal": "Передать смене контекст проверок и непрерывную ответственность.",
  "rules": [
    "Принимающая смена должна знать уже выполненный тест, гипотезу и срок.",
    "Без истории она повторяет дорогой тест и теряет 20 минут."
  ],
  "actions": [
    {
      "id": "log",
      "label": "Передать историю, гипотезу и срок",
      "outcomes": [
        {
          "when": true,
          "set": {
            "history": true
          },
          "text": "Контекст уже выполненного теста передан."
        }
      ]
    },
    {
      "id": "leave",
      "label": "Завершить старую смену без принятия",
      "outcomes": [
        {
          "when": true,
          "set": {
            "owner": "никто",
            "accepted": false
          },
          "text": "Работа потеряла ответственного."
        }
      ]
    },
    {
      "id": "accept",
      "label": "Принять работу новой сменой",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "history"
              },
              true
            ]
          },
          "set": {
            "owner": "новая смена",
            "accepted": true
          },
          "text": "Новая смена приняла состояние, гипотезу и следующий срок."
        },
        {
          "when": true,
          "set": {
            "owner": "новая смена",
            "accepted": false
          },
          "text": "Новая смена не может восстановить уже выполненные проверки."
        }
      ]
    },
    {
      "id": "work",
      "label": "Выполнить следующий диагностический шаг",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "history"
                  },
                  true
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "accepted"
                  },
                  true
                ]
              }
            ]
          },
          "set": {
            "next": "проверка новой гипотезы"
          },
          "text": "Выполнена новая проверка без повторения старой."
        },
        {
          "when": true,
          "set": {
            "lost": {
              "op": "add",
              "args": [
                {
                  "ref": "lost"
                },
                20
              ]
            },
            "next": "повтор старого теста"
          },
          "text": "Контекст не передан: повторён старый тест, затрачено ещё 20 минут."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "owner"
          },
          "никто"
        ]
      },
      "text": "Смена ушла, принимающий ещё не принял работу. Срок остался без владельца."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "next"
          },
          "повтор старого теста"
        ]
      },
      "text": "Отсутствие истории привело к повтору; {lost} минут уже потеряно. Сначала восстановите контекст."
    },
    {
      "when": true,
      "text": "Ответственный: {owner}; принятие {accepted}; история {history}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "accepted"
          },
          true
        ]
      },
      "text": "Работу приняла новая смена"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "next"
          },
          "проверка новой гипотезы"
        ]
      },
      "text": "Продолжен следующий тест"
    }
  ],
  "debrief": "Передача контекста не возвращает потраченное время. Она позволяет новой смене выбрать другой следующий опыт.",
  "title": "Организация смены и очереди",
  "condition": "Уходящая смена записала «работаем», но не гипотезу и следующий срок."
}
