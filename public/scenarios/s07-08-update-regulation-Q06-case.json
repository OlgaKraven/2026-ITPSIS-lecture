{
  "id": "s07-08-update-regulation-Q06-case",
  "revision": 2,
  "initial": {
    "process": true,
    "template": "неверный",
    "pdf": "не запрошен",
    "published": false,
    "failedRequests": 0
  },
  "fields": [
    {
      "key": "process",
      "label": "Процесс доступен"
    },
    {
      "key": "template",
      "label": "Шаблон справки"
    },
    {
      "key": "pdf",
      "label": "Последний результат выдачи"
    },
    {
      "key": "published",
      "label": "Релиз объявлен готовым"
    },
    {
      "key": "failedRequests",
      "label": "Неуспешные выдачи"
    }
  ],
  "computed": {},
  "lectureId": "s07-08-update-regulation",
  "questionId": "s07-08-update-regulation-Q06",
  "goal": "Принять релиз только после выдачи корректной справки.",
  "rules": [
    "Health проверяет доступность процесса.",
    "Новая сборка имеет неверный шаблон справки; его можно восстановить из согласованного комплекта."
  ],
  "actions": [
    {
      "id": "health",
      "label": "Проверить health",
      "outcomes": [
        {
          "when": true,
          "set": {
            "process": true
          },
          "text": "Health: процесс отвечает. Содержимое справки не проверялось."
        }
      ]
    },
    {
      "id": "request",
      "label": "Запросить контрольную справку",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "template"
              },
              "согласованный"
            ]
          },
          "set": {
            "pdf": "правильная справка"
          },
          "text": "Справка содержит обязательные поля."
        },
        {
          "when": true,
          "set": {
            "pdf": "ошибка формирования",
            "failedRequests": {
              "op": "add",
              "args": [
                {
                  "ref": "failedRequests"
                },
                1
              ]
            }
          },
          "text": "Выдача справки завершилась ошибкой шаблона."
        }
      ]
    },
    {
      "id": "publish",
      "label": "Открыть релиз пользователям",
      "outcomes": [
        {
          "when": true,
          "set": {
            "published": true
          },
          "text": "Релиз объявлен готовым; шаблон остаётся {template}."
        }
      ]
    },
    {
      "id": "pause",
      "label": "Снять объявление о готовности",
      "outcomes": [
        {
          "when": true,
          "set": {
            "published": false
          },
          "text": "Доступ к непринятому релизу приостановлен."
        }
      ]
    },
    {
      "id": "template",
      "label": "Восстановить согласованный шаблон",
      "outcomes": [
        {
          "when": true,
          "set": {
            "template": "согласованный",
            "pdf": "не запрошен"
          },
          "text": "Шаблон заменён; прежний результат запроса не подтверждает новую конфигурацию."
        }
      ]
    },
    {
      "id": "reconcile",
      "label": "Разобрать неуспешные выдачи",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "pdf"
              },
              "правильная справка"
            ]
          },
          "set": {
            "failedRequests": 0
          },
          "text": "Отказы сверены и выдачи повторены."
        },
        {
          "when": true,
          "set": {},
          "text": "Сначала получите правильную контрольную справку."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "published"
              },
              true
            ]
          },
          {
            "op": "ne",
            "args": [
              {
                "ref": "pdf"
              },
              "правильная справка"
            ]
          }
        ]
      },
      "text": "Пользователи допущены к непроверенной выдаче. Health не меняет шаблон и не формирует документ."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "pdf"
          },
          "ошибка формирования"
        ]
      },
      "text": "Сквозной запрос выявил ошибку шаблона. Нужны исправление и новая выдача."
    },
    {
      "when": {
        "op": "gte",
        "args": [
          {
            "ref": "failedRequests"
          },
          1
        ]
      },
      "text": "Контроль уже успешен, но остаются неразобранные отказы выдачи: {failedRequests}."
    },
    {
      "when": true,
      "text": "Шаблон: {template}. Последняя выдача: {pdf}. Готовность объявлена: {published}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "pdf"
          },
          "правильная справка"
        ]
      },
      "text": "Получена правильная справка"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "published"
          },
          true
        ]
      },
      "text": "Релиз открыт после проверки"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "failedRequests"
          },
          0
        ]
      },
      "text": "Неуспешные выдачи разобраны"
    }
  ],
  "debrief": "Health и сквозной тест исполняют разные операции. Исправленный шаблон требует нового запроса; старые отказы требуют сверки.",
  "title": "Проверка после обновления",
  "condition": "Проверка health успешна, пользовательская выдача справки возвращает ошибку."
}
