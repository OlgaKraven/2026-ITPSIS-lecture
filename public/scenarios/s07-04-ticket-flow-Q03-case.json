{
  "id": "s07-04-ticket-flow-Q03-case",
  "revision": 2,
  "initial": {
    "queue": "не назначен",
    "service": "отказ",
    "defect": "не создана",
    "checked": false,
    "closed": false
  },
  "fields": [
    {
      "key": "queue",
      "label": "Тип работы"
    },
    {
      "key": "service",
      "label": "Выдача"
    },
    {
      "key": "defect",
      "label": "Работа по дефекту"
    },
    {
      "key": "checked",
      "label": "Выдача проверена"
    },
    {
      "key": "closed",
      "label": "Инцидент закрыт"
    }
  ],
  "computed": {},
  "lectureId": "s07-04-ticket-flow",
  "questionId": "s07-04-ticket-flow-Q03",
  "goal": "Восстановить выдачу справки обходом и сохранить отдельную работу по дефекту.",
  "rules": [
    "Ранее доступная функция отказала. Разрешённый обход возвращает её без устранения дефекта."
  ],
  "actions": [
    {
      "id": "request",
      "label": "Назначить как новый запрос услуги",
      "outcomes": [
        {
          "when": true,
          "set": {
            "queue": "новое предоставление"
          },
          "text": "Заявка ожидает разрешения новой функции, хотя функция уже была."
        }
      ]
    },
    {
      "id": "incident",
      "label": "Назначить восстановление утраченной функции",
      "outcomes": [
        {
          "when": true,
          "set": {
            "queue": "инцидент"
          },
          "text": "Работа направлена на восстановление."
        }
      ]
    },
    {
      "id": "bypass",
      "label": "Применить разрешённый обход",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "queue"
              },
              "инцидент"
            ]
          },
          "set": {
            "service": "работает через обход",
            "checked": false
          },
          "text": "Функция восстановлена обходом; дефект сохранился."
        },
        {
          "when": true,
          "set": {
            "service": "отказ"
          },
          "text": "Новая выдача прав не восстанавливает отказавшую функцию."
        }
      ]
    },
    {
      "id": "check",
      "label": "Выполнить выдачу справки",
      "outcomes": [
        {
          "when": true,
          "set": {
            "checked": {
              "op": "eq",
              "args": [
                {
                  "ref": "service"
                },
                "работает через обход"
              ]
            }
          },
          "text": "Контрольная выдача: {checked}."
        }
      ]
    },
    {
      "id": "close",
      "label": "Закрыть все работы",
      "outcomes": [
        {
          "when": true,
          "set": {
            "closed": true,
            "defect": "закрыто без исследования"
          },
          "text": "Инцидент и дефект закрыты, причина отказа не исследована."
        }
      ]
    },
    {
      "id": "defect",
      "label": "Создать связанную работу по дефекту",
      "outcomes": [
        {
          "when": true,
          "set": {
            "defect": "открыта"
          },
          "text": "Дальнейшее исправление связано с инцидентом."
        }
      ]
    },
    {
      "id": "accept",
      "label": "Принять восстановление",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "checked"
              },
              true
            ]
          },
          "set": {
            "closed": true
          },
          "text": "Восстановление подтверждено выдачей."
        },
        {
          "when": true,
          "set": {
            "closed": false
          },
          "text": "Нет подтверждения функции."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "defect"
          },
          "закрыто без исследования"
        ]
      },
      "text": "Закрытие скрыло сохранившийся дефект. Нужно вернуть отдельную работу, не отрицая успешный обход."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "queue"
          },
          "новое предоставление"
        ]
      },
      "text": "Маршрут выдачи новых прав не выполняет восстановление прежней функции."
    },
    {
      "when": true,
      "text": "Выдача {service}; дефект {defect}; проверка {checked}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "queue"
          },
          "инцидент"
        ]
      },
      "text": "Выбран маршрут восстановления"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "checked"
          },
          true
        ]
      },
      "text": "Функция восстановлена и проверена"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "defect"
          },
          "открыта"
        ]
      },
      "text": "Дефект остаётся в отдельной работе"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "closed"
          },
          true
        ]
      },
      "text": "Восстановление принято"
    }
  ],
  "debrief": "Обход меняет доступность функции, а не состояние дефекта.",
  "title": "Инцидент как нарушение услуги",
  "condition": "Ранее доступная функция выдачи справки перестала работать."
}
