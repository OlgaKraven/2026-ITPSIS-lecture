      "key": "channel",
      "label": "Канал"
    },
    {
      "key": "message",
      "label": "Сообщение"
    },
    {
      "key": "oncall",
      "label": "Дежурный назначен"
    },
    {
      "key": "monitor",
      "label": "Резерв контролируется"
    },
    {
      "key": "accepted",
      "label": "P1 принят"
    }
  ],
  "computed": {},
  "lectureId": "s07-02-support-levels",
  "questionId": "s07-02-support-levels-Q06",
  "goal": "Доставить P1 дежурному после закрытия основного канала и проверить принятие.",
  "rules": [
    "Событие в 18:20, основной телефон закрыт в 18:00. Резервная голосовая почта без контроля не будит дежурного."
  ],
  "actions": [
    {
      "id": "send",
      "label": "Отправить P1 по выбранному каналу",
      "outcomes": [
        {
          "when": true,
          "set": {
            "message": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "channel"
                    },
                    "основной телефон"
                  ]
                },
                "канал закрыт",
                "голосовая почта"
              ]
            },
            "accepted": false
          },
          "text": "Сообщение: {message}."
        }
      ]
    },
    {
      "id": "backup",
      "label": "Переключить на резервный номер",
      "outcomes": [
        {
          "when": true,
          "set": {
            "channel": "резервный номер"
          },
          "text": "Выбран резерв. Уже отправленное сообщение не доставляется повторно само."
        }
      ]
    },
    {
      "id": "assign",
      "label": "Назначить дежурного и контроль почты",
      "outcomes": [
        {
          "when": true,
          "set": {
            "oncall": true,
            "monitor": true
          },
          "text": "Ответственный дежурный контролирует резервный канал."
        }
      ]
    },
    {
      "id": "poll",
      "label": "Проверить приём дежурным",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "message"
                  },
                  "голосовая почта"
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "oncall"
                  },
                  true
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "monitor"
                  },
                  true
                ]
              }
            ]
          },
          "set": {
            "accepted": true
          },
          "text": "Дежурный извлёк сообщение и принял P1."
        },
        {
          "when": true,
          "set": {
            "accepted": false
          },
          "text": "У принимающей стороны нет сообщения или контроля канала."
        }
      ]
    },
    {
      "id": "unwatch",
      "label": "Отключить контроль резервной почты",
      "outcomes": [
        {
          "when": true,
          "set": {
            "monitor": false,
            "accepted": false
          },
          "text": "Сообщения сохраняются, но не поступают дежурному."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "message"
          },
          "канал закрыт"
        ]
      },
      "text": "Основной канал не принял сообщение. Нужна повторная отправка доступным маршрутом."
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "message"
              },
              "голосовая почта"
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "ref": "monitor"
              },
              false
            ]
          }
        ]
      },
      "text": "Сообщение лежит в почте без контроля. Само наличие записи не является принятием P1."
    },
    {
      "when": true,
      "text": "Канал {channel}; дежурный {oncall}; контроль {monitor}; принятие {accepted}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "accepted"
          },
          true
        ]
      },
      "text": "Дежурный принял P1"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "monitor"
          },
          true
        ]
      },
      "text": "Резервный канал контролируется"
    }
  ],
  "debrief": "Смена канала не повторяет уже потерянную отправку. Контроль резервной почты обеспечивает движение сообщения.",
  "title": "Каналы приёма",
  "condition": "Телефон работает до 18:00; событие P1 поступило в 18:20, резервного канала нет."
}
