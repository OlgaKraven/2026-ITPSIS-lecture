{
  "id": "s08-03-layer-localization-Q07-case",
  "revision": 2,
  "initial": {
    "worker": false,
    "off": "нет",
    "on": "нет",
    "prodQueue": "старое имя",
    "prod": "не проверена"
  },
  "fields": [
    {
      "key": "worker",
      "label": "Worker стенда включён"
    },
    {
      "key": "off",
      "label": "Проба выключенного"
    },
    {
      "key": "on",
      "label": "Проба включённого"
    },
    {
      "key": "prodQueue",
      "label": "Очередь worker 2"
    },
    {
      "key": "prod",
      "label": "Рабочая операция"
    }
  ],
  "computed": {},
  "lectureId": "s08-03-layer-localization",
  "questionId": "s08-03-layer-localization-Q07",
  "goal": "Проверить worker на фиксированном стенде и отдельно проверить перенос на рабочую версию.",
  "rules": [
    "Стенд worker 1: выключен — сбой, включён — успех. Рабочая версия worker 2 имеет другое имя очереди.",
    "Для рабочей версии требуется отдельная корректировка имени и опыт."
  ],
  "actions": [
    {
      "id": "off",
      "label": "Выключить worker стенда",
      "outcomes": [
        {
          "when": true,
          "set": {
            "worker": false
          },
          "text": "Worker стенда выключен."
        }
      ]
    },
    {
      "id": "on",
      "label": "Включить worker стенда",
      "outcomes": [
        {
          "when": true,
          "set": {
            "worker": true
          },
          "text": "Worker стенда включён."
        }
      ]
    },
    {
      "id": "test",
      "label": "Выполнить стендовый опыт",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "worker"
              },
              false
            ]
          },
          "set": {
            "off": "сбой"
          },
          "text": "Выключенный worker воспроизвёл симптом."
        },
        {
          "when": true,
          "set": {
            "on": "успех"
          },
          "text": "Включённый worker обработал задание."
        }
      ]
    },
    {
      "id": "copy",
      "label": "Скопировать старое имя очереди в worker 2",
      "outcomes": [
        {
          "when": true,
          "set": {
            "prodQueue": "старое имя",
            "prod": "не проверена"
          },
          "text": "Рабочий worker 2 направлен в прежнюю очередь."
        }
      ]
    },
    {
      "id": "adapt",
      "label": "Задать проверенное имя очереди worker 2",
      "outcomes": [
        {
          "when": true,
          "set": {
            "prodQueue": "имя версии 2",
            "prod": "не проверена"
          },
          "text": "Рабочая конфигурация адаптирована к версии."
        }
      ]
    },
    {
      "id": "prod",
      "label": "Выполнить отдельную рабочую проверку",
      "outcomes": [
        {
          "when": true,
          "set": {
            "prod": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "prodQueue"
                    },
                    "имя версии 2"
                  ]
                },
                "успех",
                "задание не обработано"
              ]
            }
          },
          "text": "Рабочая операция: {prod}."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "prod"
          },
          "задание не обработано"
        ]
      },
      "text": "Рабочая версия не читает старую очередь. Стендовый успех не доказывает переносимость конфигурации."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "on"
          },
          "нет"
        ]
      },
      "text": "Нужны обе стороны контрольного опыта на одном стенде."
    },
    {
      "when": true,
      "text": "Стенд: выключен {off}, включён {on}; рабочая операция {prod}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "off"
              },
              "сбой"
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "ref": "on"
              },
              "успех"
            ]
          }
        ]
      },
      "text": "Связь проверена на стенде"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "prod"
          },
          "успех"
        ]
      },
      "text": "Рабочая версия проверена отдельно"
    }
  ],
  "debrief": "Перенос гипотезы между версиями требует нового опыта; копирование настройки может менять маршрут заданий.",
  "title": "Проверка гипотезы приложения",
  "condition": "На стенде отключение worker воспроизводит симптом, включение его устраняет при тех же входных данных."
}
