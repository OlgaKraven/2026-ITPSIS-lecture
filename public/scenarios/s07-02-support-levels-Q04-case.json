    "result": "нет",
    "accepted": false
  },
  "fields": [
    {
      "key": "version",
      "label": "Версия стенда"
    },
    {
      "key": "role",
      "label": "Роль стенда"
    },
    {
      "key": "draft",
      "label": "Черновик подготовлен"
    },
    {
      "key": "result",
      "label": "Результат опыта"
    },
    {
      "key": "accepted",
      "label": "Пакет принят L3"
    }
  ],
  "computed": {},
  "lectureId": "s07-02-support-levels",
  "questionId": "s07-02-support-levels-Q04",
  "goal": "Передать L3 воспроизводимый случай с версией, ролью и шагами.",
  "rules": [
    "Сбой возникает у роли «оператор» в версии 5 при отправке черновика. По умолчанию стенд открыт администратором без черновика."
  ],
  "actions": [
    {
      "id": "role",
      "label": "Войти тестовым оператором",
      "outcomes": [
        {
          "when": true,
          "set": {
            "role": "оператор",
            "result": "нет",
            "accepted": false
          },
          "text": "Роль стенда изменена; прежний опыт больше не относится к ней."
        }
      ]
    },
    {
      "id": "draft",
      "label": "Подготовить черновик",
      "outcomes": [
        {
          "when": true,
          "set": {
            "draft": true,
            "result": "нет",
            "accepted": false
          },
          "text": "Исходное состояние подготовлено."
        }
      ]
    },
    {
      "id": "run",
      "label": "Выполнить шаги отправки",
      "outcomes": [
        {
          "when": true,
          "set": {
            "result": {
              "op": "if",
              "args": [
                {
                  "op": "and",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "ref": "role"
                        },
                        "оператор"
                      ]
                    },
                    {
                      "op": "eq",
                      "args": [
                        {
                          "ref": "draft"
                        },
                        true
                      ]
                    }
                  ]
                },
                "сбой повторён",
                "сбой не повторён"
              ]
            }
          },
          "text": "Опыт: {result}."
        }
      ]
    },
    {
      "id": "send",
      "label": "Передать протокол L3",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "result"
              },
              "сбой повторён"
            ]
          },
          "set": {
            "accepted": true
          },
          "text": "L3 повторил сбой в описанных условиях."
        },
        {
          "when": true,
          "set": {
            "accepted": false
          },
          "text": "L3 не получил воспроизводимый исходный случай."
        }
      ]
    },
    {
      "id": "admin",
      "label": "Повторить с ролью администратора",
      "outcomes": [
        {
          "when": true,
          "set": {
            "role": "администратор",
            "result": "нет",
            "accepted": false
          },
          "text": "Изменена роль; условия исходного сбоя больше не соблюдены."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "result"
          },
          "сбой не повторён"
        ]
      },
      "text": "Отрицательный опыт выполнен при роли {role}, черновик {draft}. Он не исключает сбой в другом исходном состоянии."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "accepted"
          },
          true
        ]
      },
      "text": "L3 получил воспроизводимый пакет."
    },
    {
      "when": true,
      "text": "Стенд: версия {version}, роль {role}, черновик {draft}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "result"
          },
          "сбой повторён"
        ]
      },
      "text": "Сбой воспроизведён в исходных условиях"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "accepted"
          },
          true
        ]
      },
      "text": "Независимый исполнитель принял пакет"
    }
  ],
  "debrief": "Изменение условий сбрасывает результат, а выполнение читает текущую роль и данные.",
  "title": "Третья линия L3",
  "condition": "L3 получил только снимок ошибки без версии и шагов."
}
