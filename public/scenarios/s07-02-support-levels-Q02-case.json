  "computed": {},
  "lectureId": "s07-02-support-levels",
  "questionId": "s07-02-support-levels-Q02",
  "goal": "Передать диагностированный контекст L2, сохранив данные после неправомерного SQL.",
  "rules": [
    "L1 проверяет версию и симптом. SQL UPDATE выполняет профильная группа по согласованной процедуре.",
    "Стенд позволяет восстановить изменённую строку из журнала."
  ],
  "actions": [
    {
      "id": "inspect",
      "label": "Записать версию и симптом",
      "outcomes": [
        {
          "when": true,
          "set": {
            "version": true,
            "symptom": true
          },
          "text": "Контекст для L2 сохранён."
        }
      ]
    },
    {
      "id": "sql",
      "label": "Выполнить предложенный L1 SQL UPDATE",
      "outcomes": [
        {
          "when": true,
          "set": {
            "rows": "изменена без основания",
            "accepted": false
          },
          "text": "L1 изменил строку; исходная проблема не локализована."
        }
      ]
    },
    {
      "id": "send",
      "label": "Передать пакет L2",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "version"
                  },
                  true
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "symptom"
                  },
                  true
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "rows"
                  },
                  "исходное"
                ]
              }
            ]
          },
          "set": {
            "queue": "L2",
            "accepted": true
          },
          "text": "L2 принял проверяемый пакет."
        },
        {
          "when": true,
          "set": {
            "queue": "возврат L1",
            "accepted": false
          },
          "text": "L2 вернул пакет: не хватает контекста либо данные уже изменены."
        }
      ]
    },
    {
      "id": "restore",
      "label": "Восстановить строку по журналу",
      "outcomes": [
        {
          "when": true,
          "set": {
            "rows": "исходное"
          },
          "text": "Строка возвращена; свидетельства контекста не появились автоматически."
        }
      ]
    },
    {
      "id": "guess",
      "label": "Отправить только диагноз «сломана БД»",
      "outcomes": [
        {
          "when": true,
          "set": {
            "queue": "диагноз без свидетельств",
            "accepted": false
          },
          "text": "Группа получила недоказанный диагноз без воспроизводимого опыта."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "rows"
          },
          "изменена без основания"
        ]
      },
      "text": "Диагностируемые данные изменены. Перед проверкой нужен возврат строки и сохранение контекста."
    },
    {
      "when": {
        "op": "ne",
        "args": [
          {
            "ref": "queue"
          },
          "L2"
        ]
      },
      "text": "Пакет находится в состоянии «{queue}». Версия {version}; симптом {symptom}."
    },
    {
      "when": true,
      "text": "L2 принял пакет с исходными данными."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "rows"
          },
          "исходное"
        ]
      },
      "text": "Данные восстановлены"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "accepted"
          },
          true
        ]
      },
      "text": "L2 принял пригодный пакет"
    }
  ],
  "debrief": "SQL меняет данные, а не только оценку действия. Сбор контекста после SQL не отменяет его изменения.",
  "title": "Первая линия L1",
  "condition": "Инструкция L1 требует проверить версию; оператор сразу меняет конфигурацию БД."
}
