    {
      "key": "print",
      "label": "Результат печати"
    }
  ],
  "computed": {},
  "lectureId": "s07-07-knowledge-base",
  "questionId": "s07-07-knowledge-base-Q03",
  "goal": "Найти статью по симптому и применить вариант текущей версии.",
  "rules": [
    "Пользователь работает на 8.0 и ищет «печать пустой справки».",
    "Заголовок INC-392 не индексируется по этому симптому. Найденные варианты 7.1 и 8.0 имеют разные настройки."
  ],
  "actions": [
    {
      "id": "title",
      "label": "Добавить симптом и область в заголовок",
      "outcomes": [
        {
          "when": true,
          "set": {
            "title": "Пустая справка — версии 7.1 и 8.0"
          },
          "text": "Статья теперь индексируется по пользовательскому симптому."
        }
      ]
    },
    {
      "id": "search",
      "label": "Искать «печать пустой справки»",
      "outcomes": [
        {
          "when": true,
          "set": {
            "found": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "title"
                    },
                    "INC-392"
                  ]
                },
                "ничего",
                "два варианта по версиям"
              ]
            }
          },
          "text": "Поиск: {found}."
        }
      ]
    },
    {
      "id": "old",
      "label": "Выбрать первый вариант 7.1",
      "outcomes": [
        {
          "when": true,
          "set": {
            "selected": "7.1"
          },
          "text": "Выбран вариант 7.1 без проверки применимости."
        }
      ]
    },
    {
      "id": "current",
      "label": "Выбрать вариант 8.0",
      "outcomes": [
        {
          "when": true,
          "set": {
            "selected": "8.0"
          },
          "text": "Выбран вариант текущей версии."
        }
      ]
    },
    {
      "id": "apply",
      "label": "Выполнить выбранные шаги",
      "outcomes": [
        {
          "when": true,
          "set": {
            "config": {
              "ref": "selected"
            },
            "print": "не проверен"
          },
          "text": "Настройка печати изменена по варианту {selected}."
        }
      ]
    },
    {
      "id": "test",
      "label": "Напечатать контрольную справку",
      "outcomes": [
        {
          "when": true,
          "set": {
            "print": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "config"
                    },
                    "8.0"
                  ]
                },
                "полная справка",
                "пустая справка"
              ]
            }
          },
          "text": "Результат: {print}."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "found"
          },
          "ничего"
        ]
      },
      "text": "Пользователь не находит знание по симптому; внутренний номер не отражает его запрос."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "print"
          },
          "пустая справка"
        ]
      },
      "text": "Статья найдена, но выбранный вариант не подходит. Нужны другие шаги, а не только новое название."
    },
    {
      "when": true,
      "text": "Выбран {selected}; настройка {config}; печать {print}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "found"
          },
          "два варианта по версиям"
        ]
      },
      "text": "Статья находится по симптому"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "print"
          },
          "полная справка"
        ]
      },
      "text": "Применён подходящий вариант"
    }
  ],
  "debrief": "Находимость и пригодность — два разных перехода. Выбор статьи не выполняет её шаги.",
  "title": "Заголовок и симптом",
  "condition": "Статья называется «INC-392»; пользователи ищут «печать пустой справки»."
