{
  "id": "s07-09-change-management-Q07-case",
  "revision": 2,
  "initial": {
    "traffic": 5,
    "build": "новая",
    "errors": 0,
    "lost": 0,
    "verified": false
  },
  "fields": [
    {
      "key": "traffic",
      "label": "Доля трафика",
      "unit": "%"
    },
    {
      "key": "build",
      "label": "Сборка"
    },
    {
      "key": "errors",
      "label": "Ошибки стадии",
      "unit": "%"
    },
    {
      "key": "lost",
      "label": "Неуспешные операции"
    },
    {
      "key": "verified",
      "label": "Стадия проверена"
    }
  ],
  "computed": {},
  "lectureId": "s07-09-change-management",
  "questionId": "s07-09-change-management-Q07",
  "goal": "Расширить внедрение только после устранения отказа следующей стадии.",
  "rules": [
    "Канарейка 5% успешна. На стадии 25% новая сборка даёт 8% ошибок при допустимых 2%.",
    "Исправленная сборка на той же стадии даёт 1%. Расширение без возврата теряет операции; они повторяются по журналу."
  ],
  "actions": [
    {
      "id": "expand",
      "label": "Расширить до 25%",
      "outcomes": [
        {
          "when": true,
          "set": {
            "traffic": 25,
            "errors": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "build"
                    },
                    "новая"
                  ]
                },
                8,
                1
              ]
            },
            "verified": false
          },
          "text": "На 25% трафика ошибок {errors}%."
        }
      ]
    },
    {
      "id": "all",
      "label": "Развернуть на 100% сразу",
      "outcomes": [
        {
          "when": true,
          "set": {
            "traffic": 100,
            "lost": {
              "op": "add",
              "args": [
                {
                  "ref": "lost"
                },
                {
                  "op": "if",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "ref": "build"
                        },
                        "новая"
                      ]
                    },
                    20,
                    0
                  ]
                }
              ]
            },
            "verified": false
          },
          "text": "Доля 100%; неуспешных операций {lost}."
        }
      ]
    },
    {
      "id": "return",
      "label": "Вернуть трафик к проверенным 5%",
      "outcomes": [
        {
          "when": true,
          "set": {
            "traffic": 5,
            "errors": 0,
            "verified": false
          },
          "text": "Расширение остановлено; накопленные отказы сохранены."
        }
      ]
    },
    {
      "id": "fix",
      "label": "Установить исправленную сборку на малой стадии",
      "requires": {
        "op": "eq",
        "args": [
          {
            "ref": "traffic"
          },
          5
        ]
      },
      "blocked": "Сначала верните контролируемую малую стадию.",
      "outcomes": [
        {
          "when": true,
          "set": {
            "build": "исправленная",
            "verified": false
          },
          "text": "Сборка исправлена."
        }
      ]
    },
    {
      "id": "verify",
      "label": "Проверить порог текущей стадии",
      "outcomes": [
        {
          "when": true,
          "set": {
            "verified": {
              "op": "and",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "traffic"
                    },
                    25
                  ]
                },
                {
                  "op": "lt",
                  "args": [
                    {
                      "ref": "errors"
                    },
                    2
                  ]
                }
              ]
            }
          },
          "text": "Порог текущей стадии соблюдён: {verified}."
        }
      ]
    },
    {
      "id": "replay",
      "label": "Повторить неуспешные операции",
      "requires": {
        "op": "eq",
        "args": [
          {
            "ref": "verified"
          },
          true
        ]
      },
      "blocked": "Сначала подтвердите исправленную стадию.",
      "outcomes": [
        {
          "when": true,
          "set": {
            "lost": 0
          },
          "text": "Накопленные отказы обработаны."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "gte",
        "args": [
          {
            "ref": "lost"
          },
          1
        ]
      },
      "text": "Расширение распространило отказ: {lost} неуспешных операций. Возврат трафика не повторит их."
    },
    {
      "when": {
        "op": "gte",
        "args": [
          {
            "ref": "errors"
          },
          2
        ]
      },
      "text": "Стадия 25% нарушила порог: {errors}%. Расширение нужно остановить, затем испытать исправление."
    },
    {
      "when": true,
      "text": "Трафик {traffic}%; сборка {build}; ошибки {errors}%; проверка {verified}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "verified"
          },
          true
        ]
      },
      "text": "Новая стадия прошла порог"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "lost"
          },
          0
        ]
      },
      "text": "Неуспешные операции обработаны"
    }
  ],
  "debrief": "Успех 5% не предсказывает стадию 25%. Возврат ограничивает новый ущерб, повтор устраняет накопленный.",
  "title": "Внедрение и наблюдение",
  "condition": "Канарейка успешна на 5% трафика, для остальных 95% результата ещё нет."
}
