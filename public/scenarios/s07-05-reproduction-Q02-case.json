      "label": "Вывод"
    }
  ],
  "computed": {},
  "lectureId": "s07-05-reproduction",
  "questionId": "s07-05-reproduction-Q02",
  "goal": "Получить сопоставимые результаты загрузки файла ниже и выше лимита.",
  "rules": [
    "Лимит 10 МБ. Доступны файлы 8 и 14 МБ; каждый прогон начинается из пустого черновика."
  ],
  "actions": [
    {
      "id": "small",
      "label": "Выбрать файл 8 МБ",
      "outcomes": [
        {
          "when": true,
          "set": {
            "size": 8
          },
          "text": "Выбран файл 8 МБ; черновик {draft}."
        }
      ]
    },
    {
      "id": "large",
      "label": "Выбрать файл 14 МБ",
      "outcomes": [
        {
          "when": true,
          "set": {
            "size": 14
          },
          "text": "Выбран файл 14 МБ."
        }
      ]
    },
    {
      "id": "reset",
      "label": "Очистить черновик перед опытом",
      "outcomes": [
        {
          "when": true,
          "set": {
            "draft": "пустой"
          },
          "text": "Предусловие пустого черновика восстановлено."
        }
      ]
    },
    {
      "id": "upload",
      "label": "Загрузить выбранный файл",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "draft"
              },
              "занят"
            ]
          },
          "set": {
            "conclusion": "опыт смешан с состоянием черновика"
          },
          "text": "Повтор не сопоставим: черновик остался от другого прогона."
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "size"
              },
              8
            ]
          },
          "set": {
            "small": "успех",
            "draft": "занят"
          },
          "text": "Файл 8 МБ загружен."
        },
        {
          "when": true,
          "set": {
            "large": "отказ лимита",
            "draft": "занят"
          },
          "text": "Файл 14 МБ отвергнут: превышение лимита на 4 МБ."
        }
      ]
    },
    {
      "id": "compare",
      "label": "Сравнить оба прогона",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "small"
                  },
                  "успех"
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "large"
                  },
                  "отказ лимита"
                ]
              }
            ]
          },
          "set": {
            "conclusion": "подтверждена граница объёма в опыте"
          },
          "text": "При одинаковых предусловиях различается только объём."
        },
        {
          "when": true,
          "set": {
            "conclusion": "не хватает сопоставимых прогонов"
          },
          "text": "Нет обоих результатов при пустом исходном черновике."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "conclusion"
          },
          "опыт смешан с состоянием черновика"
        ]
      },
      "text": "Следующий прогон использовал занятый черновик; очистите его и повторите опыт."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "small"
          },
          "нет"
        ]
      },
      "text": "Нужен контрольный файл ниже лимита, а не только повтор большого файла."
    },
    {
      "when": true,
      "text": "8 МБ: {small}; 14 МБ: {large}; черновик {draft}; вывод {conclusion}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "conclusion"
          },
          "подтверждена граница объёма в опыте"
        ]
      },
      "text": "Сопоставлены два контролируемых результата"
    }
  ],
  "debrief": "Очистка черновика меняет предусловие. Без неё последующий опыт может проверять другой механизм.",
  "title": "Уточняющие вопросы",
  "condition": "Известно только «не загружается файл». Можно спросить цвет окна или размер файла."
