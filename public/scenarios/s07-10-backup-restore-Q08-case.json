    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "accepted"
              },
              true
            ]
          },
          {
            "op": "ne",
            "args": [
              {
                "ref": "result"
              },
              "успех"
            ]
          }
        ]
      },
      "text": "Приёмка не обеспечена пользовательским результатом."
    },
    {
      "when": true,
      "text": "Каталог {files}; путь {path}; связи {links}; заявка {result}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "result"
          },
          "успех"
        ]
      },
      "text": "Контрольная заявка открывается"
