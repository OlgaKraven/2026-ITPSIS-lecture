                  },
                  true
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "path"
                  },
                  "восстановленный"
                ]
              }
            ]
          },
          "set": {
            "links": true
          },
          "text": "Идентификаторы вложений найдены в каталоге."
        },
        {
          "when": true,
          "set": {
            "links": false
          },
          "text": "Связи не разрешаются по текущему пути."
        }
      ]
    },
    {
      "id": "open",
      "label": "Открыть заявку со вложением",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "files"
                  },
                  true
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "path"
                  },
                  "восстановленный"
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "links"
                  },
                  true
                ]
              }
            ]
          },
          "set": {
            "result": "успех"
          },
          "text": "Заявка и вложение открыты."
        },
        {
          "when": true,
          "set": {
            "result": "вложение недоступно",
            "accepted": false
          },
          "text": "БД ответила, но вложение недоступно."
        }
      ]
    },
    {
      "id": "accept",
      "label": "Принять услугу по доступности БД",
      "outcomes": [
        {
          "when": true,
          "set": {
            "accepted": true
          },
          "text": "Приёмка записана; результат заявки {result}."
        }
      ]
    },
    {
      "id": "verify",
      "label": "Принять по контрольной заявке",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "result"
              },
              "успех"
            ]
          },
          "set": {
            "accepted": true
          },
          "text": "Услуга принята по сквозному результату."
        },
        {
          "when": true,
          "set": {
            "accepted": false
          },
          "text": "Сквозного результата нет."
        }
      ]
    },
    {
      "id": "disconnect",
      "label": "Отключить каталог вложений",
      "outcomes": [
        {
          "when": true,
          "set": {
            "files": false,
            "links": false,
            "result": "не выполнялась",
            "accepted": false
          },
          "text": "Каталог отключён; предыдущие связи больше не подтверждают открытие."
        }
      ]
    }
  ],
  "scenes": [
