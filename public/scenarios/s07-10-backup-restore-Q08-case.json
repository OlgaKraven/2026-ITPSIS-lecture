  "goal": "Восстановить связи вложений и пройти контрольную заявку.",
  "rules": [
    "БД восстановлена. Файлы лежат в другом каталоге, ссылка приложения указывает старый путь."
  ],
  "actions": [
    {
      "id": "files",
      "label": "Подключить восстановленный каталог",
      "outcomes": [
        {
          "when": true,
          "set": {
            "files": true,
            "links": false,
            "result": "не выполнялась"
