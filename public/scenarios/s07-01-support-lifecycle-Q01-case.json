{
  "id": "s07-01-support-lifecycle-Q01-case",
  "revision": 2,
  "initial": {
    "template": "дефектный",
    "file": "нет",
    "field": "не проверено",
    "closed": false
  },
  "fields": [
    {
      "key": "template",
      "label": "Шаблон PDF"
    },
    {
      "key": "file",
      "label": "Скачанный PDF"
    },
    {
      "key": "field",
      "label": "Обязательное поле"
    },
    {
      "key": "closed",
      "label": "Запись закрыта"
    }
  ],
  "computed": {},
  "lectureId": "s07-01-support-lifecycle",
  "questionId": "s07-01-support-lifecycle-Q01",
  "goal": "Исправить формирование обязательного поля PDF и принять проверенный документ.",
  "rules": [
    "Скачивание проверяет передачу файла, а не его содержимое. На стенде доступен исправленный шаблон."
  ],
  "actions": [
    {
      "id": "patch",
      "label": "Установить исправленный шаблон",
      "outcomes": [
        {
          "when": true,
          "set": {
            "template": "исправленный",
            "field": "не проверено",
            "closed": false
          },
          "text": "Шаблон обновлён; ранее скачанный файл не меняется."
        }
      ]
    },
    {
      "id": "download",
      "label": "Скачать PDF",
      "outcomes": [
        {
          "when": true,
          "set": {
            "file": {
              "ref": "template"
            },
            "field": "не проверено"
          },
          "text": "Получен файл из шаблона «{file}»."
        }
      ]
    },
    {
      "id": "read",
      "label": "Проверить обязательное поле",
      "outcomes": [
        {
          "when": true,
          "set": {
            "field": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "file"
                    },
                    "исправленный"
                  ]
                },
                "заполнено",
                "пусто"
              ]
            },
            "closed": false
          },
          "text": "Поле в скачанном PDF: {field}."
        }
      ]
    },
    {
      "id": "close",
      "label": "Закрыть исправление по скачиванию",
      "outcomes": [
        {
          "when": true,
          "set": {
            "closed": true
          },
          "text": "Исправление закрыто; содержимое PDF остаётся «{field}»."
        }
      ]
    },
    {
      "id": "reopen",
      "label": "Возобновить проверку",
      "outcomes": [
        {
          "when": true,
          "set": {
            "closed": false
          },
          "text": "Проверка возобновлена; прежний файл сохранён."
        }
      ]
    },
    {
      "id": "accept",
      "label": "Принять исправление по содержимому",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "field"
              },
              "заполнено"
            ]
          },
          "set": {
            "closed": true
          },
          "text": "Обязательное поле заполнено; исправление принято."
        },
        {
          "when": true,
          "set": {
            "closed": false
          },
          "text": "Файл не выполняет требование к содержимому."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "field"
          },
          "пусто"
        ]
      },
      "text": "PDF скачивается, но обязательное поле пусто. Нужен новый файл после исправления шаблона."
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "closed"
              },
              true
            ]
          },
          {
            "op": "ne",
            "args": [
              {
                "ref": "field"
              },
              "заполнено"
            ]
          }
        ]
      },
      "text": "Закрытая запись не подтверждает правильность документа. Возобновите проверку."
    },
    {
      "when": true,
      "text": "Шаблон {template}; файл {file}; поле {field}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "field"
          },
          "заполнено"
        ]
      },
      "text": "Обязательное поле заполнено"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "closed"
          },
          true
        ]
      },
      "text": "Исправление принято"
    }
  ],
  "debrief": "Установка меняет генератор, скачивание создаёт конкретный файл, проверка читает именно его. Старый PDF не исправляется задним числом.",
  "title": "Система после ввода в эксплуатацию",
  "condition": "В системе выдачи справок студент скачал готовый документ, а сотрудник деканата отфильтровал список заявок. Инженер исправил подтверждённую ошибку формирования PDF и проверил результат на стенде. По записи «оператор открыл панель» цель действия неизвестна."
}
