  "lectureId": "s07-07-knowledge-base",
  "questionId": "s07-07-knowledge-base-Q04",
  "goal": "Выполнить поддерживаемую настройку в 8.0 после проверки механизма.",
  "rules": [
    "Параметр legacyMode из инструкции 7.1 удалён в 8.0.",
    "Для 8.0 проверен параметр rendererMode=compatible. Неизвестный параметр блокирует загрузку конфигурации."
  ],
  "actions": [
    {
      "id": "legacy",
      "label": "Добавить legacyMode по старой статье",
      "outcomes": [
        {
          "when": true,
          "set": {
            "legacy": true,
            "service": "отказ неизвестного параметра",
            "tested": false
          },
          "text": "8.0 не загрузила конфигурацию с удалённым параметром."
        }
      ]
    },
    {
      "id": "inspect",
      "label": "Проверить схему параметров 8.0",
      "outcomes": [
        {
          "when": true,
          "set": {
            "mechanism": true
          },
          "text": "В 8.0 используется rendererMode; legacyMode отсутствует."
        }
      ]
    },
    {
      "id": "remove",
      "label": "Удалить legacyMode из конфигурации",
      "outcomes": [
        {
          "when": true,
          "set": {
            "legacy": false,
            "service": "работает",
            "tested": false
          },
          "text": "Конфигурация снова загружается; режим ещё {mode}."
        }
      ]
    },
    {
      "id": "mode",
      "label": "Установить проверенный rendererMode=compatible",
      "requires": {
        "op": "eq",
        "args": [
          {
            "ref": "mechanism"
          },
          true
        ]
      },
      "blocked": "Сначала исследуйте различие механизма.",
      "outcomes": [
        {
          "when": true,
          "set": {
            "mode": "compatible",
            "tested": false
          },
          "text": "Выбран поддерживаемый режим."
        }
      ]
    },
    {
      "id": "test",
      "label": "Выполнить пользовательскую операцию",
      "outcomes": [
        {
          "when": true,
          "set": {
            "tested": {
              "op": "and",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "legacy"
                    },
                    false
                  ]
                },
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "mode"
                    },
                    "compatible"
                  ]
                }
              ]
            }
          },
          "text": "Проверка функции: {tested}."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "legacy"
          },
          true
        ]
      },
      "text": "Неизвестный параметр мешает загрузке. Новая настройка не отменяет старую строку автоматически."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "mechanism"
          },
          false
        ]
      },
      "text": "Применимость старой инструкции ещё не установлена."
    },
    {
      "when": true,
      "text": "Конфигурация {service}; режим {mode}; функция {tested}."
    }
  ],
  "checks": [
