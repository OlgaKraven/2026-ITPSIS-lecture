{
  "id": "s08-05-hardware-maintenance-Q01-case",
  "revision": 2,
  "initial": {
    "selected": "не выбрана",
    "actual": "A101",
    "record": "A101",
    "wrong": false,
    "done": false
  },
  "fields": [
    {
      "key": "selected",
      "label": "Выбранная единица"
    },
    {
      "key": "actual",
      "label": "Фактический серийный номер на месте A101"
    },
    {
      "key": "record",
      "label": "Серийный номер в карточке"
    },
    {
      "key": "wrong",
      "label": "Чужой сервер отключён"
    },
    {
      "key": "done",
      "label": "Замена выполнена"
    }
  ],
  "computed": {},
  "lectureId": "s08-05-hardware-maintenance",
  "questionId": "s08-05-hardware-maintenance-Q01",
  "goal": "Обслужить нужную физическую единицу и сохранить историю замены.",
  "rules": [
    "Два сервера с именем DOC: серийные номера A101 и B202. Задание относится к A101. После замены его физическая единица имеет номер C303."
  ],
  "actions": [
    {
      "id": "name",
      "label": "Выбрать первый DOC по имени",
      "outcomes": [
        {
          "when": true,
          "set": {
            "selected": "B202"
          },
          "text": "Одинаковое имя привело к выбору B202."
        }
      ]
    },
    {
      "id": "serial",
      "label": "Сверить задание и выбрать A101 по номеру",
      "outcomes": [
        {
          "when": true,
          "set": {
            "selected": "A101"
          },
          "text": "Физическая единица идентифицирована."
        }
      ]
    },
    {
      "id": "replace",
      "label": "Выполнить разрешённую замену выбранного сервера",
      "outcomes": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "ref": "selected"
              },
              "A101"
            ]
          },
          "set": {
            "actual": "C303",
            "done": true
          },
          "text": "На месте A101 установлен C303. Карточка пока содержит {record}."
        },
        {
          "when": true,
          "set": {
            "wrong": true
          },
          "text": "По ошибке отключён B202; целевой сервер не заменён."
        }
      ]
    },
    {
      "id": "return",
      "label": "Вернуть ошибочно отключённый B202",
      "outcomes": [
        {
          "when": true,
          "set": {
            "wrong": false
          },
          "text": "Чужой сервер возвращён в работу."
        }
      ]
    },
    {
      "id": "history",
      "label": "Зафиксировать замену A101 на C303 с историей",
      "outcomes": [
        {
          "when": true,
          "set": {
            "record": {
              "ref": "actual"
            }
          },
          "text": "Карточка обновлена до {record}, прежняя единица сохранена в истории."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "wrong"
          },
          true
        ]
      },
      "text": "Отключена другая физическая единица. Исправление карточки не включит её обратно."
    },
    {
      "when": {
        "op": "ne",
        "args": [
          {
            "ref": "record"
          },
          {
            "ref": "actual"
          }
        ]
      },
      "text": "Оборудование заменено, карточка ещё указывает прежний серийный номер."
    },
    {
      "when": true,
      "text": "Выбрано {selected}; физически {actual}; учёт {record}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "done"
          },
          true
        ]
      },
      "text": "Заменена нужная единица"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "wrong"
          },
          false
        ]
      },
      "text": "Чужой сервер работает"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "record"
          },
          "C303"
        ]
      },
      "text": "Сохранена история новой единицы"
    }
  ],
  "debrief": "Имя может сохраняться после замены, серийный номер и физическая работа меняются отдельно.",
  "title": "Единица учёта оборудования",
  "condition": "Два сервера названы одинаково, серийные номера различаются."
}
