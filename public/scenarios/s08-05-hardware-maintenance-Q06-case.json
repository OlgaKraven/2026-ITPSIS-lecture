  "goal": "Подтвердить неисправность чтением и проверить замену накопителя.",
  "rules": [
    "SMART не показывает тревог, но контрольное чтение трёх блоков даёт две ошибки.",
    "Повтор того же чтения на заменённом разрешённым порядком накопителе не даёт ошибок."
  ],
  "actions": [
    {
      "id": "smart",
      "label": "Принять накопитель по SMART",
      "outcomes": [
        {
          "when": true,
          "set": {
            "accepted": true
          },
          "text": "Накопитель принят без контрольного чтения."
        }
      ]
    },
    {
      "id": "read",
      "label": "Прочитать те же контрольные блоки",
      "outcomes": [
        {
          "when": true,
          "set": {
            "errors": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "disk"
                    },
                    "исходный"
                  ]
                },
                2,
                0
              ]
            },
            "read": true,
            "accepted": false
          },
          "text": "Контрольное чтение: {errors} ошибок."
        }
      ]
    },
    {
      "id": "clear",
      "label": "Очистить запись об ошибках вместо исправления",
      "outcomes": [
        {
          "when": true,
          "set": {
            "errors": 0,
            "read": false,
            "accepted": true
          },
          "text": "Счётчик очищен; физический накопитель остался {disk}."
        }
      ]
    },
    {
      "id": "replace",
      "label": "Выполнить разрешённую замену с сохранением данных",
      "outcomes": [
        {
          "when": true,
          "set": {
            "disk": "заменённый",
            "read": false,
            "accepted": false
          },
          "text": "Накопитель заменён, данные перенесены; нужен повтор чтения."
        }
      ]
    },
    {
      "id": "accept",
      "label": "Принять по контрольному чтению",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "read"
                  },
                  true
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "errors"
                  },
                  0
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "disk"
                  },
                  "заменённый"
                ]
              }
            ]
          },
          "set": {
            "accepted": true
          },
          "text": "Те же блоки читаются без ошибок."
        },
        {
          "when": true,
          "set": {
            "accepted": false
          },
          "text": "Фактическое чтение не подтвердило исправность."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
