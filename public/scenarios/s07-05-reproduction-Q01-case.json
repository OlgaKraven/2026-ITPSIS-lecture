{
  "id": "s07-05-reproduction-Q01-case",
  "revision": 2,
  "initial": {
    "proxy": 8,
    "db": "работает",
    "trace": false,
    "client": "не выполнен",
    "server": 100
  },
  "fields": [
    {
      "key": "proxy",
      "label": "Задержка прокси",
      "unit": "с"
    },
    {
      "key": "db",
      "label": "БД"
    },
    {
      "key": "trace",
      "label": "Сопоставлен requestId"
    },
    {
      "key": "client",
      "label": "Результат клиента"
    },
    {
      "key": "server",
      "label": "Время сервера",
      "unit": "мс"
    }
  ],
  "computed": {},
  "lectureId": "s07-05-reproduction",
  "questionId": "s07-05-reproduction-Q01",
  "goal": "Сопоставить один запрос и проверить участок между быстрым сервером и клиентом.",
  "rules": [
    "Сервер отвечает за 100 мс. Прокси удерживает ответ 8 секунд; клиентский предел — 5 секунд. Перезапуск БД не меняет прокси."
  ],
  "actions": [
    {
      "id": "request",
      "label": "Повторить тот же запрос",
      "outcomes": [
        {
          "when": true,
          "set": {
            "client": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "db"
                    },
                    "остановлена"
                  ]
                },
                "ошибка сервера",
                {
                  "op": "if",
                  "args": [
                    {
                      "op": "gte",
                      "args": [
                        {
                          "ref": "proxy"
                        },
                        5
                      ]
                    },
                    "тайм-аут",
                    "ответ получен"
                  ]
                }
              ]
            }
          },
          "text": "Клиент: {client}; сервер: {server} мс."
        }
      ]
    },
    {
      "id": "db",
      "label": "Перезапустить БД",
      "outcomes": [
        {
          "when": true,
          "set": {
            "db": "перезапущена"
          },
          "text": "БД перезапущена, задержка прокси {proxy} секунд сохранена."
        }
      ]
    },
    {
      "id": "trace",
      "label": "Связать клиент, прокси и сервер по requestId",
      "outcomes": [
        {
          "when": true,
          "set": {
            "trace": true
          },
          "text": "След показывает быстрый сервер и задержку доставки ответа."
        }
      ]
    },
    {
      "id": "proxy",
      "label": "Исправить правило буферизации прокси",
      "requires": {
        "op": "eq",
        "args": [
          {
            "ref": "trace"
          },
          true
        ]
      },
      "blocked": "Сначала установите связь именно этого запроса.",
      "outcomes": [
        {
          "when": true,
          "set": {
            "proxy": 0,
            "client": "не выполнен"
          },
          "text": "Задержка прокси снята; нужен новый клиентский запрос."
        }
      ]
    },
    {
      "id": "stop-db",
      "label": "Остановить БД для диагностики",
      "outcomes": [
        {
          "when": true,
          "set": {
            "db": "остановлена",
            "client": "ошибка сервера"
          },
          "text": "Появился дополнительный серверный отказ."
        }
      ]
    },
    {
      "id": "start-db",
      "label": "Восстановить работу БД",
      "outcomes": [
        {
          "when": true,
          "set": {
            "db": "работает",
            "client": "не выполнен"
          },
          "text": "БД работает; задержка прокси не изменилась."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "db"
          },
          "остановлена"
        ]
      },
      "text": "Диагностическое вмешательство добавило отказ БД. Восстановите её отдельно."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "client"
          },
          "тайм-аут"
        ]
      },
      "text": "Сервер завершил запрос быстро, клиент не получил ответ вовремя. Следующий опыт должен проверить доставку."
    },
    {
      "when": true,
      "text": "Прокси {proxy} с.; клиент {client}; БД {db}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "trace"
          },
          true
        ]
      },
      "text": "Связан один и тот же запрос"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "proxy"
          },
          0
        ]
      },
      "text": "Задержка доставки устранена"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "client"
          },
          "ответ получен"
        ]
      },
      "text": "Клиент получил результат"
    },
    {
      "when": {
        "op": "ne",
        "args": [
          {
            "ref": "db"
          },
          "остановлена"
        ]
      },
      "text": "Дополнительный отказ БД устранён"
    }
  ],
  "debrief": "Симптом не задаёт причину. Перезапуск другого слоя не меняет задержку доставки.",
  "title": "Симптом без диагноза",
  "condition": "Клиент показал тайм-аут. В журнале нет причины."
}
