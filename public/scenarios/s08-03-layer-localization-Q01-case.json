                        "работает"
                      ]
                    },
                    {
                      "op": "eq",
                      "args": [
                        {
                          "ref": "db"
                        },
                        "работает"
                      ]
                    }
                  ]
                },
                "успех",
                "отказ"
              ]
            }
          },
          "text": "Выдача в обоих клиентах: {result}."
        }
      ]
    }
