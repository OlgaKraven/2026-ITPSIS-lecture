{
  "id": "s07-08-update-regulation-Q08-case",
  "revision": 2,
  "initial": {
    "app": 5,
    "schema": 2,
    "reported": "нет",
    "errors": 0,
    "observed": false,
    "closed": false
  },
  "fields": [
    {
      "key": "app",
      "label": "Версия приложения"
    },
    {
      "key": "schema",
      "label": "Версия схемы"
    },
    {
      "key": "reported",
      "label": "Версии в отчёте"
    },
    {
      "key": "errors",
      "label": "Ошибок на 100 запросов"
    },
    {
      "key": "observed",
      "label": "Наблюдение выполнено"
    },
    {
      "key": "closed",
      "label": "Окно закрыто"
    }
  ],
  "computed": {},
  "lectureId": "s07-08-update-regulation",
  "questionId": "s07-08-update-regulation-Q08",
  "goal": "Закрыть окно с фактическими версиями, проверенной функцией и обработанным ростом ошибок.",
  "rules": [
    "После установки версия приложения 5, схема 2.",
    "В учебном наблюдении новая сборка даёт 12 ошибок из 100 запросов. Порог плана — 5. Проверенный возврат даёт 1 ошибку из 100."
  ],
  "actions": [
    {
      "id": "installer",
      "label": "Закрыть окно по успеху установщика",
      "outcomes": [
        {
          "when": true,
          "set": {
            "closed": true,
            "reported": "установщик завершён"
          },
          "text": "Окно закрыто; версии и результат услуги не зафиксированы."
        }
      ]
    },
    {
      "id": "observe",
      "label": "Выполнить серию из 100 запросов",
      "outcomes": [
        {
          "when": true,
          "set": {
            "errors": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "app"
                    },
                    5
                  ]
                },
                12,
                1
              ]
            },
            "observed": true
          },
          "text": "В серии {errors} ошибок из 100 запросов."
        }
      ]
    },
    {
      "id": "report",
      "label": "Записать текущие версии и результат",
      "outcomes": [
        {
          "when": true,
          "set": {
            "reported": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "app"
                    },
                    5
                  ]
                },
                "приложение 5 / схема 2",
                "приложение 4 / схема 1"
              ]
            }
          },
          "text": "Зафиксирован фактический состав: {reported}."
        }
      ]
    },
    {
      "id": "reopen",
      "label": "Возобновить контроль окна",
      "visible": {
        "op": "eq",
        "args": [
          {
            "ref": "closed"
          },
          true
        ]
      },
      "outcomes": [
        {
          "when": true,
          "set": {
            "closed": false
          },
          "text": "Окно снова под контролем, история установки сохранена."
        }
      ]
    },
    {
      "id": "rollback",
      "label": "Выполнить согласованный возврат приложения и БД",
      "outcomes": [
        {
          "when": true,
          "set": {
            "app": 4,
            "schema": 1,
            "observed": false,
            "errors": 0,
            "closed": false
          },
          "text": "Совместимая точка 4/1 восстановлена; требуется новое наблюдение."
        }
      ]
    },
    {
      "id": "close",
      "label": "Закрыть окно по критериям",
      "outcomes": [
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "observed"
                  },
                  true
                ]
              },
              {
                "op": "lt",
                "args": [
                  {
                    "ref": "errors"
                  },
                  5
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "ref": "reported"
                  },
                  "приложение 4 / схема 1"
                ]
              }
            ]
          },
          "set": {
            "closed": true
          },
          "text": "Окно закрыто с фактическими версиями и успешным контролем."
        },
        {
          "when": true,
          "set": {
            "closed": false
          },
          "text": "Критерии закрытия не выполнены: ошибок {errors}; отчёт «{reported}»."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "closed"
              },
              true
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "ref": "observed"
              },
              false
            ]
          }
        ]
      },
      "text": "Окно закрыто без наблюдения. Пользовательский эффект установки ещё неизвестен."
    },
    {
      "when": {
        "op": "gte",
        "args": [
          {
            "ref": "errors"
          },
          5
        ]
      },
      "text": "Порог нарушен: {errors} ошибок на 100 запросов. Успех установщика не устраняет отказы."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "observed"
          },
          false
        ]
      },
      "text": "Текущий состав {app}/{schema}; выполните наблюдение именно этого состояния."
    },
    {
      "when": true,
      "text": "Результат серии: {errors} ошибок. Отчёт: {reported}. Закрыто: {closed}."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "observed"
          },
          true
        ]
      },
      "text": "Наблюдался текущий состав"
    },
    {
      "when": {
        "op": "lt",
        "args": [
          {
            "ref": "errors"
          },
          5
        ]
      },
      "text": "Порог ошибок соблюдён"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "reported"
          },
          "приложение 4 / схема 1"
        ]
      },
      "text": "Зафиксированы фактические версии"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "closed"
          },
          true
        ]
      },
      "text": "Окно закрыто по результату"
    }
  ],
  "debrief": "Возврат меняет версии и сбрасывает прежнее наблюдение. Отчёт нужно обновить по восстановленному составу, а не по завершённому установщику.",
  "title": "Закрытие окна и отчёт",
  "condition": "Установка закончена, но не записаны отклонения и фактические версии."
}
