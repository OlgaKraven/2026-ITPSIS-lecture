{
  "id": "s07-02-support-levels-Q03-case",
  "revision": 2,
  "initial": {
    "queue": 0,
    "api": "ожидание",
    "workers": "активны",
    "done": 0,
    "lost": 0
  },
  "fields": [
    {
      "key": "queue",
      "label": "Заданий в очереди"
    },
    {
      "key": "api",
      "label": "Внешний API"
    },
    {
      "key": "workers",
      "label": "Обработчики"
    },
    {
      "key": "done",
      "label": "Завершено за интервал"
    },
    {
      "key": "lost",
      "label": "Удалено без результата"
    }
  ],
  "computed": {},
  "lectureId": "s07-02-support-levels",
  "questionId": "s07-02-support-levels-Q03",
  "goal": "Устранить ожидание внешнего API и обработать очередь без потери заданий.",
  "rules": [
    "За 5 минут приходит 40, без исправления завершается 25. Все обработчики активны; ограничение — внешний API.",
    "После восстановления API за интервал разрешена обработка 55, включая накопленный остаток."
  ],
  "actions": [
    {
      "id": "tick",
      "label": "Провести интервал 5 минут",
      "outcomes": [
        {
          "when": true,
          "set": {
            "queue": {
              "op": "max",
              "args": [
                0,
                {
                  "op": "add",
                  "args": [
                    {
                      "ref": "queue"
                    },
                    {
                      "op": "if",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "ref": "api"
                            },
                            "работает"
                          ]
                        },
                        -15,
                        15
                      ]
                    }
                  ]
                }
              ]
            },
            "done": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "ref": "api"
                    },
                    "работает"
                  ]
                },
                {
                  "op": "min",
                  "args": [
                    55,
                    {
                      "op": "add",
                      "args": [
                        {
                          "ref": "queue"
                        },
                        40
                      ]
                    }
                  ]
                },
                25
              ]
            }
          },
          "text": "Пришло 40; завершено {done}; остаток {queue}."
        }
      ]
    },
    {
      "id": "restart",
      "label": "Перезапустить активные обработчики",
      "outcomes": [
        {
          "when": true,
          "set": {
            "workers": "перезапущены"
          },
          "text": "Обработчики перезапущены; ожидание внешнего API сохраняется."
        }
      ]
    },
    {
      "id": "api",
      "label": "Восстановить разрешённый маршрут API",
      "outcomes": [
        {
          "when": true,
          "set": {
            "api": "работает"
          },
          "text": "API отвечает; накопленные задания пока в очереди."
        }
      ]
    },
    {
      "id": "purge",
      "label": "Удалить остаток очереди",
      "outcomes": [
        {
          "when": true,
          "set": {
            "lost": {
              "op": "add",
              "args": [
                {
                  "ref": "lost"
                },
                {
                  "ref": "queue"
                }
              ]
            },
            "queue": 0
          },
          "text": "Очередь обнулена удалением. Без результата удалено {lost} заданий."
        }
      ]
    },
    {
      "id": "replay",
      "label": "Вернуть удалённые задания из входящего журнала",
      "outcomes": [
        {
          "when": true,
          "set": {
            "queue": {
              "op": "add",
              "args": [
                {
                  "ref": "queue"
                },
                {
                  "ref": "lost"
                }
              ]
            },
            "lost": 0
          },
          "text": "Задания возвращены в очередь для фактической обработки."
        }
      ]
    }
  ],
  "scenes": [
    {
      "when": {
        "op": "ne",
        "args": [
          {
            "ref": "lost"
          },
          0
        ]
      },
      "text": "Удаление сократило очередь, но потеряло {lost} заданий. Их нужно вернуть из входящего журнала."
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "api"
          },
          "ожидание"
        ]
      },
      "text": "Все обработчики доступны; внешнее ожидание сохраняет дисбаланс +15 заданий за интервал."
    },
    {
      "when": true,
      "text": "API восстановлен. В очереди {queue}; следующий интервал может обработать накопленный остаток."
    }
  ],
  "checks": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "api"
          },
          "работает"
        ]
      },
      "text": "Внешний маршрут восстановлен"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "queue"
          },
          0
        ]
      },
      "text": "Очередь обработана"
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "ref": "lost"
          },
          0
        ]
      },
      "text": "Задания не потеряны"
    },
    {
      "when": {
        "op": "gte",
        "args": [
          {
            "ref": "done"
          },
          40
        ]
      },
      "text": "Проверена обработка после исправления"
    }
  ],
  "debrief": "Перезапуск не меняет внешнюю зависимость. Удаление очереди меняет счётчик, но не создаёт результаты заданий.",
  "title": "Вторая линия L2",
  "condition": "L2 видит рост очереди, но ещё не проверил число обработчиков."
}
